{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "ax-coder",
  "version": "7.24.5",
  "description": "Persistent desktop supervision for AX Code projects.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "node script/require-pnpm.cjs",
    "postinstall": "node desktop/scripts/fix-node-pty-permissions.mjs",
    "dev": "turbo run dev --filter=@ax-code/electron",
    "build": "turbo run build --filter=@ax-code/electron",
    "typecheck": "pnpm --filter \"./desktop/packages/*\" --if-present run type-check",
    "lint": "pnpm --filter \"./desktop/packages/*\" --if-present run lint",
    "test": "pnpm run test:scripts && pnpm --filter \"./desktop/packages/*\" --if-present run test",
    "test:scripts": "vitest run --config vitest.config.ts",
    "check:desktop-boundaries": "tsx script/check-desktop-boundaries.ts --fail-on-violation",
    "check:desktop-store-boundaries": "tsx script/check-desktop-store-boundaries.ts",
    "check:desktop-electron-runtime": "node desktop/scripts/check-electron-runtime.mjs",
    "check:desktop-endpoint-contracts": "node desktop/scripts/check-endpoint-contracts.mjs",
    "check:desktop-ipc-contracts": "node desktop/scripts/check-desktop-ipc-contracts.mjs",
    "check:desktop-package-tests": "node desktop/scripts/check-package-test-scripts.mjs",
    "check:no-sibling-dependencies": "node script/check-no-sibling-dependencies.mjs",
    "check:source-ownership": "node script/source-ownership-contract.mjs",
    "check:runtime-pin": "node script/runtime-pin.mjs",
    "check:release-policy": "node script/release-policy.mjs check",
    "check:release-contract": "node script/desktop-release-contract.mjs",
    "check:boundaries": "pnpm run check:desktop-boundaries && pnpm run check:desktop-store-boundaries && pnpm run check:desktop-electron-runtime && pnpm run check:desktop-endpoint-contracts && pnpm run check:desktop-ipc-contracts && pnpm run check:desktop-package-tests && pnpm run check:no-sibling-dependencies && pnpm run check:source-ownership && pnpm run check:runtime-pin && pnpm run check:release-policy && pnpm run check:release-contract",
    "smoke:packaged": "node desktop/packages/electron/scripts/smoke-packaged-app.mjs",
    "smoke:packaged-asar-cli": "node desktop/packages/electron/scripts/smoke-packaged-asar-cli.mjs",
    "smoke:native-webmcp": "node desktop/packages/electron/scripts/smoke-native-webmcp.mjs",
    "smoke:electron-compatibility": "node desktop/packages/electron/scripts/smoke-electron-compatibility.mjs",
    "smoke:launch-animations": "node desktop/packages/electron/scripts/smoke-launch-animations.mjs",
    "check:launch-animations": "node desktop/scripts/check-launch-animations.mjs",
    "package:desktop": "node desktop/packages/electron/scripts/package.mjs",
    "shadow:evidence": "node script/shadow-release-evidence.mjs",
    "winget:generate": "tsx tools/winget/generate-manifests.ts",
    "check:locales": "tsx script/check-locales.ts",
    "release:preflight": "node script/desktop-release-preflight.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "catalog:",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fast-glob": "catalog:",
    "globals": "^16.3.0",
    "prettier": "3.6.2",
    "tsx": "4.22.4",
    "turbo": "2.9.14",
    "typescript": "catalog:",
    "typescript-eslint": "^8.39.1",
    "vitest": "4.1.9"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "node-pty"
    ],
    "ignoredBuiltDependencies": [
      "@ibm/plex"
    ]
  }
}
