{
  "schema": "ax-coder.desktop-release-policy.v1",
  "stage": "shadow-only",
  "publicRelease": {
    "enabled": false,
    "repository": "defai-digital/ax-code",
    "tagPrefix": "desktop-v"
  },
  "cutover": {
    "repository": "defai-digital/ax-code-desktop",
    "tagPrefix": "v",
    "decision": ".internal/adr/ADR-009-independent-desktop-release-preparation.md",
    "requiredEvidence": ["signed-shadow", "upgrade", "rollback", "data-and-credential-continuity", "human-approval"]
  },
  "shadow": {
    "workflow": "desktop-shadow.yml",
    "artifactChannel": "github-actions",
    "retentionDays": 7,
    "signingMode": "explicit-only"
  }
}
