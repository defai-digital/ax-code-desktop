  "settings.magicPrompts.page.group.planImplement.description": "\uc800\uc7a5\ub41c \uacc4\ud68d\uc744 \uad6c\ud604 \ud750\ub984\uc73c\ub85c \ubcf4\ub0bc \ub54c \uc4f0\ub294 \uc228\uaca8\uc9c4 \ud504\ub86c\ud504\ud2b8\uc785\ub2c8\ub2e4.",
  "settings.magicPrompts.page.group.sessionSummary.title": "\uc138\uc158 \uc694\uc57d",
  "settings.magicPrompts.page.group.sessionSummary.description": "/summary \uc2ac\ub798\uc2dc \uba85\ub839\uc5d0 \uc4f0\ub294 \ud504\ub86c\ud504\ud2b8\uc785\ub2c8\ub2e4. \ud45c\uc2dc\ub418\ub294 \uc0ac\uc6a9\uc790 \uba54\uc2dc\uc9c0\uc640 \uc228\uaca8\uc9c4 \uc9c0\uce68\uc73c\ub85c \uad6c\uc131\ub429\ub2c8\ub2e4. \ube44\ud30c\uad34\uc801\uc774\uba70 \uc138\uc158 \uae30\ub85d\uc744 \uc555\ucd95\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
  "settings.magicPrompts.page.group.sessionWorkspaceReview.title": "\uc6cc\ud06c\uc2a4\ud398\uc774\uc2a4 \uac80\ud1a0",
  "settings.magicPrompts.page.group.sessionExplore.title": "\ucf54\ub4dc\ubca0\uc774\uc2a4 \ub458\ub7ec\ubcf4\uae30",
  "settings.magicPrompts.page.group.sessionExplore.description": "/explore \uc2ac\ub798\uc2dc \uba85\ub839\uc5d0 \uc4f0\ub294 \ud504\ub86c\ud504\ud2b8\uc785\ub2c8\ub2e4. \ud45c\uc2dc\ub418\ub294 \uc0ac\uc6a9\uc790 \uba54\uc2dc\uc9c0\uc640 \uc228\uaca8\uc9c4 \uc9c0\uce68\uc73c\ub85c \uad6c\uc131\ub429\ub2c8\ub2e4. \uc800\uc7a5\uc18c\ub97c \uc870\uc0ac\ud574 \ud30c\uc77c\ubcc4 \ub098\uc5f4\uc774 \uc544\ub2c8\ub77c \uc804\uccb4 \uadf8\ub9bc, \uc8fc\uc694 \ubaa8\ub4c8, \uc5f0\uacb0 \ubc29\uc2dd, \uc2dc\uc791 \uc9c0\uc810\uc744 \uad6c\uc870\uc801\uc73c\ub85c \uc548\ub0b4\ud569\ub2c8\ub2e4.",
  "settings.magicPrompts.page.group.sessionWorkspaceReview.description": "/workspace-review \uc2ac\ub798\uc2dc \uba85\ub839\uc5d0 \uc4f0\ub294 \ud504\ub86c\ud504\ud2b8\uc785\ub2c8\ub2e4. \ud45c\uc2dc\ub418\ub294 \uc0ac\uc6a9\uc790 \uba54\uc2dc\uc9c0\uc640 \uc228\uaca8\uc9c4 \uc9c0\uce68\uc73c\ub85c \uad6c\uc131\ub429\ub2c8\ub2e4. \uc6cc\ud06c\uc2a4\ud398\uc774\uc2a4 diff\uac00 \uc758\ub3c4\ub97c \ub2ec\uc131\ud558\ub294\uc9c0, \uc62c\ubc14\ub974\uace0 \ucda9\ubd84\ud55c\uc9c0 \uac80\ud1a0\ud558\uace0 \ubc1c\uacac \uc0ac\ud56d\uc744 \uc2ec\uac01\ub3c4\ubcc4\ub85c \ubd84\ub958\ud569\ub2c8\ub2e4.",
  "settings.magicPrompts.page.group.sessionFeaturePlan.title": "\uae30\ub2a5 \uacc4\ud68d",
  "settings.magicPrompts.page.group.sessionFeaturePlan.description": "/plan-feature \uc2ac\ub798\uc2dc \uba85\ub839\uc5d0 \uc4f0\ub294 \ud504\ub86c\ud504\ud2b8\uc785\ub2c8\ub2e4. \ud45c\uc2dc\ub418\ub294 \uc0ac\uc6a9\uc790 \uba54\uc2dc\uc9c0\uc640 \uc228\uaca8\uc9c4 \uc9c0\uce68\uc73c\ub85c \uad6c\uc131\ub429\ub2c8\ub2e4. \ucf54\ub4dc\ub97c \uc870\uc0ac\ud558\uace0 \uc18c\ub7c9\uc73c\ub85c \ud655\uc778 \uc9c8\ubb38\uc744 \ud55c \ub4a4 \uad6c\ud604 \uacc4\ud68d\uc744 \ub9cc\ub4dc\ub294 \uc548\ub0b4\ud615 \ub300\ud654\ub97c \uc9c4\ud589\ud569\ub2c8\ub2e4.",
  "settings.magicPrompts.page.group.sessionCatchUp.title": "\ub530\ub77c\uc7a1\uae30",
  "settings.magicPrompts.page.group.sessionCatchUp.description": "/catch-up \uc2ac\ub798\uc2dc \uba85\ub839\uc5d0 \uc4f0\ub294 \ud504\ub86c\ud504\ud2b8\uc785\ub2c8\ub2e4. \ud45c\uc2dc\ub418\ub294 \uc0ac\uc6a9\uc790 \uba54\uc2dc\uc9c0\uc640 \uc228\uaca8\uc9c4 \uc9c0\uce68\uc73c\ub85c \uad6c\uc131\ub429\ub2c8\ub2e4. \ube0c\ub79c\uce58 \ucee4\ubc0b, PR, \ucee4\ubc0b\ub418\uc9c0 \uc54a\uc740 \uc791\uc5c5\uc744 \ud568\uaed8 \ubcf4\ub294 \ube0c\ub79c\uce58 \uc778\uc2dd \ub9e5\ub77d\uc73c\ub85c \ud558\ub358 \uc77c\uc744 \ud30c\uc545\ud55c \ub4a4, \uc77d\uae30 \uc26c\uc6b4 \uc694\uc57d\uacfc \uc81c\ud488 \uc911\uc2ec\uc758 \ub2e4\uc74c \ub2e8\uacc4\ub97c \uc81c\uc2dc\ud569\ub2c8\ub2e4.",
  "settings.magicPrompts.page.group.sessionDebug.title": "\ub514\ubc84\uae45",
  "settings.magicPrompts.page.group.sessionDebug.description": "/debug \uc2ac\ub798\uc2dc \uba85\ub839\uc5d0 \uc4f0\ub294 \ud504\ub86c\ud504\ud2b8\uc785\ub2c8\ub2e4. \ud45c\uc2dc\ub418\ub294 \uc0ac\uc6a9\uc790 \uba54\uc2dc\uc9c0\uc640 \uc228\uaca8\uc9c4 \uc9c0\uce68\uc73c\ub85c \uad6c\uc131\ub429\ub2c8\ub2e4. \uc99d\uc0c1\uc744 \ud3ec\ucc29\ud558\uace0 \uac00\uc124\uc744 \uc138\uc6b4 \ub4a4 \ucf54\ub4dc\uc640 \ub300\uc870\ud574 \ud655\uc778\ud558\uace0, \uc6d0\uc778\uc744 \ud655\uc815\ud55c \ub2e4\uc74c \uc218\uc815\uc744 \uc81c\uc548\ud558\ub294 \uc548\ub0b4\ud615 \uadfc\ubcf8 \uc6d0\uc778 \uc870\uc0ac\ub97c \uc9c4\ud589\ud569\ub2c8\ub2e4.",
  "settings.magicPrompts.page.group.sessionWeigh.title": "\uc120\ud0dd\uc9c0 \ube44\uad50",
  "settings.magicPrompts.page.group.sessionWeigh.description": "/weigh \uc2ac\ub798\uc2dc \uba85\ub839\uc5d0 \uc4f0\ub294 \ud504\ub86c\ud504\ud2b8\uc785\ub2c8\ub2e4. \ud45c\uc2dc\ub418\ub294 \uc0ac\uc6a9\uc790 \uba54\uc2dc\uc9c0\uc640 \uc228\uaca8\uc9c4 \uc9c0\uce68\uc73c\ub85c \uad6c\uc131\ub429\ub2c8\ub2e4. \ucf54\ub4dc\ub97c \uc870\uc0ac\ud55c \ub4a4 \uc11c\ub85c \ub2e4\ub978 \uc811\uadfc 2~3\uac00\uc9c0\ub97c \ud2b8\ub808\uc774\ub4dc\uc624\ud504\uc640 \uad8c\uc7a5\uc548\uacfc \ud568\uaed8 \uc81c\uc2dc\ud558\uba70, \uacc4\ud68d\uc774\ub098 \ucf54\ub4dc\ub294 \uc791\uc131\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
  "settings.magicPrompts.page.group.sessionFusion.title": "\ud4e8\uc804",
  "settings.magicPrompts.page.group.sessionFusion.description": "\uc5ec\ub7ec \uc2e4\ud589 \uacb0\uacfc\ub97c \ud558\ub098\uc758 \ucd5c\uc885 \ub2f5\ubcc0\uc73c\ub85c \ud569\uce60 \ub54c \uc4f0\ub294 \ud504\ub86c\ud504\ud2b8\uc785\ub2c8\ub2e4. \uc6d0\ubcf8 \uacb0\uacfc \uc55e\uc5d0 \ud45c\uc2dc\ub418\ub294 \uc0ac\uc6a9\uc790 \uba54\uc2dc\uc9c0\uc640 \uc228\uaca8\uc9c4 \uc9c0\uce68\uc774 \uc635\ub2c8\ub2e4.",
