der);\n248:  * GhosttyTerminal - High-performance terminal emulator\n249:  *\n250:  * Uses Ghostty's native RenderState for optimal performance:\n251:  * - ONE call to update all state (renderStateUpdate)\n252:  * - ONE call to get all cells (getViewport)\n253:  * - No per-row WASM boundary crossings!\n254:  */\n255: export class GhosttyTerminal {\n256:   private exports: GhosttyWasmExports;\n257:   private memory: WebAssembly.Memory;\n258:   private handle: TerminalHandle;\n259:   private _cols: number;\n260:   private _rows: number;\n261: \n262:   /** Size of GhosttyCell in WASM (16 bytes) */\n263:   private static readonly CELL_SIZE = 16;\n264: \n265:   /** Reusable buffer for viewport operations */\n266:   private viewportBufferPtr: number = 0;\n267:   private viewportBufferSize: number = 0;\n268: \n269:   /** Cell pool for zero-allocation rendering */\n270:   private cellPool: GhosttyCell[] = [];\n271: \n272:   /**\n273:    * True while the wasm viewport buffer holds the current viewport; cleared by anything that can change it (write,\n274:    * resize). Rows are parsed from it into cellPool on demand, so a frame that repaints one row parses one row.\n275:    */\n276:   private viewportValid = false;\n277:   /** Per-row flag: cellPool holds this row of the current viewport. Reset whenever the viewport is reloaded. */\n278:   private rowParsed = new Uint8Array(0);\n279:   private allRowsParsed = false;\n280: \n281:   /** Separate buffer for scrollback lines, so reading history never overwrites unparsed viewport rows. */\n282:   private scrollbackBufferPtr: number = 0;\n283:   private scrollbackBufferSize: number = 0;\n284: \n285:   /** Reusable wasm buffer that write() encodes into, so a write does not allocate in wasm memory. */\n286:   private writeBufferPtr: number = 0;\n287:   private writeBufferSize: number = 0;\n288:   private static readonly WRITE_BUFFER_MAX = 1 << 20;\n289:   private static readonly encoder = new TextEncoder();\n290: \n291:   constructor(\n292:     exports: GhosttyWasmExports,\n293:     memory: WebAssembly.Memory,\n294:     cols: number = 80,\n295:     rows: number = 24,\n296:     config?: GhosttyTerminalConfig\n297:   ) {\n298:     this.exports = exports;\n299:     this.memory = memory;\n300:     this._cols = cols;\n301:     this._rows = rows;\n302: \n303:     if (config) {\n304:       // Allocate config struct in WASM memory\n305:       const configPtr = this.exports.ghostty_wasm_alloc_u8_array(GHOSTTY_CONFIG_SIZE);\n306:       if (configPtr === 0) {\n307:         throw new Error('Failed to allocate config (out of memory)');\n308:       }\n309: \n310:       try {\n311:         // Write config to WASM memory\n312:         const view = new DataView(this.memory.buffer);\n313:         let offset = configPtr;\n314: \n315:         // scrollback_limit (u32)\n316:         view.setUint32(offset, config.scrollbackLimit ?? 10000, true);\n317:         offset += 4;\n318: \n319:         // fg_color (u32)\n320:         view.setUint32(offset, config.fgColor ?? 0, true);\n336: \n337:         this.handle = this.exports.ghostty_terminal_new_with_config(cols, rows, configPtr);\n338:       } finally {\n339:         // Free the config memory\n340:         this.exports.ghostty_wasm_free_u8_array(configPtr, GHOSTTY_CONFIG_SIZE);\n341:       }\n342:     } else {\n343:       this.handle = this.exports.ghostty_terminal_new(cols, rows);\n344:     }\n345: \n346:     if (!this.handle) throw new Error('Failed to create terminal');\n347: \n348:     this.initCellPool();\n359:   // Lifecycle\n360:   // ==========================================================================\n361: \n362:   write(data: string | Uint8Array): void {\n363:     this.viewportValid = false;\n364:     const maxBuffered = GhosttyTerminal.WRITE_BUFFER_MAX;\n365: \n366:     if (typeof data === 'string') {\n367:       // UTF-8 needs at most 3 bytes per UTF-16 unit, so encode straight into the reusable wasm buffer.\n368:       const capacity = data.length * 3;\n369:       if (capacity === 0) return;\n370:       if (capacity <= maxBuffered) {\n371:         const ptr = this.ensureWriteBuffer(capacity);\n372:         const target = new Uint8Array(this.memory.buffer, ptr, capacity);\n373:         const { written } = GhosttyTerminal.encoder.encodeInto(data, target);\n374:         this.exports.ghostty_terminal_write(this.handle, ptr, written);\n375:         return;\n376:       }\n377:       data = GhosttyTerminal.encoder.encode(data);\n378:     }\n379: \n380:     const length = data.length;\n381:     if (length === 0) return;\n382:     if (length <= maxBuffered) {\n383:       const ptr = this.ensureWriteBuffer(length);\n384:       new Uint8Array(this.memory.buffer, ptr, length).set(data);\n385:       this.exports.ghostty_terminal_write(this.handle, ptr, length);\n386:       return;\n387:     }\n388: \n389:     // Rare very large write: use a one-off allocation rather than pinning a large buffer.\n390:     const ptr = this.exports.ghostty_wasm_alloc_u8_array(length);\n391:     new Uint8Array(this.memory.buffer, ptr, length).set(data);\n392:     this.exports.ghostty_terminal_write(this.handle, ptr, length);\n393:     this.exports.ghostty_wasm_free_u8_array(ptr, length);\n394:   }\n395: \n396:   private ensureWriteBuffer(needed: number): number {\n397:     if (this.writeBufferPtr && this.writeBufferSize >= needed) return this.writeBufferPtr;\n398:     if (this.writeBufferPtr) {\n399:       this.exports.ghostty_wasm_free_u8_array(this.writeBufferPtr, this.writeBufferSize);\n400:     }\n401:     const size = Math.min(\n402:       GhosttyTerminal.WRITE_BUFFER_MAX,\n403:       Math.max(needed, this.writeBufferSize * 2, 4096)\n404:     );\n405:     this.writeBufferPtr = this.exports.ghostty_wasm_alloc_u8_array(size);\n406:     this.writeBufferSize = size;\n407:     return this.writeBufferPtr;\n408:   }\n409: \n410:   resize(cols: number, rows: number): void {\n411:     if (cols === this._cols && rows === this._rows) return;\n412:     this._cols = cols;\n413:     this._rows = rows;\n419: \n420:   free(): void {\n421:     if (this.writeBufferPtr) {\n422:       this.exports.ghostty_wasm_free_u8_array(this.writeBufferPtr, this.writeBufferSize);\n423:       this.writeBufferPtr = 0;\n424:       this.writeBufferSize = 0;\n425:     }\n426:     if (this.viewportBufferPtr) {\n427:       this.exports.ghostty_wasm_free_u8_array(this.viewportBufferPtr, this.viewportBufferSize);\n428:       this.viewportBufferPtr = 0;\n429:     }\n430:     if (this.scrollbackBufferPtr) {\n431:       this.exports.ghostty_wasm_free_u8_array(this.scrollbackBufferPtr, this.scrollbackBufferSize);\n432:       this.scrollbackBufferPtr = 0;\n433:     }\n434:     this.exports.ghostty_terminal_free(this.handle);\n435:   }\n436: \n437:   // ==========================================================================\n438:   // RenderState API - The key performance optimization\n439:   // ==========================================================================\n440: \n441:   /**\n442:    * Update render state from terminal.\n443:    *\n444:    * This syncs the RenderState with the current Terminal state.\n445:    * The dirty state (full/partial/none) is stored in the WASM RenderState\n446:    * and can be queried via isRowDirty(). When dirty==full, isRowDirty()\n447:    * returns true for ALL rows.\n448:    *\n449:    * The WASM layer automatically detects screen switches (normal <-> alternate)\n450:    * and returns FULL dirty state when switching screens (e.g., vim exit).\n452:    * Safe to call multiple times - dirty state persists until markClean().\n453:    */\n454:   update(): DirtyState {\n455:     return this.exports.ghostty_render_state_update(this.handle) as DirtyState;\n456:   }\n457: \n458:   /**\n459:    * Get cursor state from render state.\n460:    * Ensures render state is fresh by calling update().\n461:    */\n462:   getCursor(): RenderStateCursor {\n463:     // Call update() to ensure render state is fresh.\n464:     // This is safe to call multiple times - dirty state persists until markClean().\n465:     this.update();\n466:     const x = this.exports.ghostty_render_state_get_cursor_x(this.handle);\n467:     const y = this.exports.ghostty_render_state_get_cursor_y(this.handle);\n468:     return {\n469:       x,\n470:       y,\n471:       viewportX: x,\n472:       viewportY: y,\n473:       visible: this.exports.ghostty_render_state_get_cursor_visible(this.handle),\n474:       blinking: false, // TODO: Add blinking support\n475:       style: 'block', // TODO: Add style support\n476:     };\n477:   }\n478: \n479:   /**\n480:    * Get default colors from render state\n481:    */\n482:   getColors(): RenderStateColors {\n483:     const bg = this.exports.ghostty_render_state_get_bg_color(this.handle);\n484:     const fg = this.exports.ghostty_render_state_get_fg_color(this.handle);\n\nFILE desktop/packages/akitty-web/lib/terminal.ts\n1: /**\n2:  * Terminal - Main terminal emulator class\n3:  *\n4:  * Provides an xterm.js-compatible API wrapping Ghostty's WASM terminal emulator.\n5:  *\n6:  * Usage:\n7:  * ```typescript\n8:  * import { init, Terminal } from '@ax-code/akitty-web';\n9:  *\n10:  * await init();\n11:  * const term = new Terminal();\n12:  * term.open(document.getElementById('container'));\n13:  * term.write('Hello, World!\\n');\n14:  * term.onData(data => console.log('User typed:', data));\n15:  * ```\n16:  */\n17: \n18: import { BufferNamespace } from './buffer';\n19: import { EventEmitter } from './event-emitter';\n20: import type { Ghostty, GhosttyCell, GhosttyTerminal, GhosttyTerminalConfig } from './ghostty';\n21: import { getGhostty } from './index';\n22: import { InputHandler } from './input-handler';\n23: import type {\n24:   IBufferNamespace,\n25:   IBufferRange,\n26:   IDisposable,\n27:   IEvent,\n28:   IKeyEvent,\n29:   ITerminalAddon,\n30:   ITerminalCore,\n31:   ITerminalOptions,\n32:   IUnicodeVersionProvider,\n33: } from './interfaces';\n34: import { LinkDetector } from './link-detector';\n35: import { OSC8LinkProvider } from './providers/osc8-link-provider';\n36: import { UrlRegexProvider } from './providers/url-regex-provider';\n37: import { CanvasRenderer } from './renderer';\n38: import { SelectionManager } from './selection-manager';\n39: import type { ILink, ILinkProvider } from './types';\n40: \n41: // ============================================================================\n42: // Title/Bell Scanner\n43: // ============================================================================\n44: \n45: /** Hard cap on the pending OSC payload retained while waiting for a terminator. */\n46: const MAX_OSC_PAYLOAD_LENGTH = 4096;\n47: \n48: /** ECMA-48 CAN and SUB: either one cancels whatever sequence is pending. */\n49: const CAN = 0x18;\n50: const SUB = 0x1a;\n51: \n52: type ScannerState =\n53:   | 'ground'\n54:   | 'escape'\n55:   | 'csi'\n56:   | 'osc'\n57:   | 'oscEscape'\n58:   | 'string'\n59:   | 'stringEscape';\n60: \n61: /**\n62:  * Stateful, bounded scanner for the two events Ghostty's WASM API does not surface: the window\n63:  * title (OSC 0/2) and the bell (BEL).\n64:  *\n65:  * Both arrive interleaved with ordinary output and may be split across writes at any byte, so the\n208: \n209:   private appendOsc(code: number): void {\n210:     if (this.overflowed) return;\n211:     if (this.pending.length >= MAX_OSC_PAYLOAD_LENGTH) {\n212:       // Keep consuming until the terminator, but stop retaining data.\n213:       this.overflowed = true;\n214:       this.pending = '';\n215:       return;\n216:     }\n217:     this.pending += String.fromCharCode(code);\n218:   }\n219: \n266: \n267:   // Components (created on open())\n268:   private ghostty?: Ghostty;\n269:   public wasmTerm?: GhosttyTerminal; // Made public for link providers\n270:   public renderer?: CanvasRenderer; // Made public for FitAddon\n271:   private inputHandler?: InputHandler;\n272:   private selectionManager?: SelectionManager;\n273:   private canvas?: HTMLCanvasElement;\n274: \n275:   // Link detection system\n276:   private linkDetector?: LinkDetector;\n277:   private currentHoveredLink?: ILink;\n278:   private mouseMoveThrottleTimeout?: number;\n286:   private keyEmitter = new EventEmitter<IKeyEvent>();\n287:   private titleChangeEmitter = new EventEmitter<string>();\n288:   private scrollEmitter = new EventEmitter<number>();\n289:   private renderEmitter = new EventEmitter<{ start: number; end: number }>();\n290:   private cursorMoveEmitter = new EventEmitter<void>();\n291:   // Public event accessors (xterm.js compatibility)\n292:   private revision = 0;\n293: \n294:   /** Window title last set by OSC 0/2, or an empty string. */\n295:   public get title(): string {\n296:     return this.currentTitle;\n297:   }\n311:   public readonly onKey: IEvent<IKeyEvent> = this.keyEmitter.event;\n312:   public readonly onTitleChange: IEvent<string> = this.titleChangeEmitter.event;\n313:   public readonly onScroll: IEvent<number> = this.scrollEmitter.event;\n314:   public readonly onRender: IEvent<{ start: number; end: number }> = this.renderEmitter.event;\n315:   public readonly onCursorMove: IEvent<void> = this.cursorMoveEmitter.event;\n316: \n317:   // Lifecycle state\n318:   private isOpen = false;\n319:   private isDisposed = false;\n320:   private animationFrameId?: number;\n321: \n322:   // Addons\n335: \n336:   // Phase 2: Viewport and scrolling state\n337:   public viewportY: number = 0; // Top line of viewport in scrollback buffer (0 = at bottom, can be fractional during smooth scroll)\n338:   private targetViewportY: number = 0; // Target viewport position for smooth scrolling\n339:   private scrollAnimationStartTime?: number;\n340:   private scrollAnimationStartY?: number;\n341:   private scrollAnimationFrame?: number;\n342:   private customWheelEventHandler?: (event: WheelEvent) => boolean;\n343:   private lastCursorY: number = 0; // Track cursor position for onCursorMove\n344: \n345:   // Scrollbar interaction state\n346:   private isDraggingScrollbar: boolean = false;\n348:   private scrollbarDragStartViewportY: number = 0;\n349: \n350:   // Scrollbar visibility/auto-hide state\n351:   private renderFailed: boolean = false;\n352:   // Off-screen terminals (hidden tab or pane) skip drawing; the next visible frame redraws everything.\n353:   private onScreen: boolean = true;\n354:   private redrawOnShow: boolean = false;\n355:   private visibilityObserver?: IntersectionObserver;\n356:   private scrollbarVisible: boolean = false;\n357:   private scrollbarOpacity: number = 0;\n358:   private scrollbarHideTimeout?: number;\n359:   private scrollbarAnimationFrame?: number\n422: \n423:       case 'cursorBlink':\n424:       case 'cursorStyle':\n425:         if (this.renderer) {\n426:           this.renderer.setCursorStyle(this.options.cursorStyle);\n427:           this.renderer.setCursorBlink(this.options.cursorBlink);\n428:         }\n429:         break;\n430: \n431:       case 'theme':\n432:         if (this.renderer) {\n433:           console.warn('akitty-web: theme changes after open() are not yet fully supported');\n434:         }\n435:         break;\n436: \n437:       case 'fontSize':\n438:         if (this.renderer) {\n439:           this.renderer.setFontSize(this.options.fontSize);\n440:           this.handleFontChange();\n441:         }\n442:         break;\n443: \n444:       case 'fontFamily':\n445:         if (this.renderer) {\n446:           this.renderer.setFontFamily(this.options.fontFamily);\n447:           this.handleFontChange();\n448:         }\n449:         break;\n450: \n451:       case 'lineHeight':\n452:         if (this.renderer) {\n453:           this.renderer.setLineHeight(this.options.lineHeight);\n454:           this.handleFontChange();\n455:         }\n456:         break;\n457: \n458:       case 'cols':\n459:       case 'rows':\n460:         // Redirect to resize method\n461:         this.resize(this.options.cols, this.options.rows);\n465: \n466:   /**\n467:    * Handle font changes (fontSize or fontFamily)\n468:    * Updates canvas size to match new font metrics and forces a full re-render\n469:    */\n470:   private handleFontChange(): void {\n471:     if (!this.renderer || !this.wasmTerm || !this.canvas) return;\n472: \n473:     // Clear any active selection since pixel positions have changed\n474:     if (this.selectionManager) {\n475:       this.selectionManager.clearSelection();\n476:     }\n477: \n478:     // Resize canvas to match new font metrics\n479:     this.renderer.resize(this.cols, this.rows);\n480: \n481:     // Update canvas element dimensions to match renderer\n482:     const metrics = this.renderer.getMetrics();\n483:     this.canvas.width = metrics.width * this.cols;\n484:     this.canvas.height = metrics.height * this.rows;\n485:     this.canvas.style.width = `${metrics.width * this.cols}px`;\n486:     this.canvas.style.height = `${metrics.height * this.rows}px`;\n487: \n488:     // Force full re-render with new font\n489:     this.renderer.render(this.wasmTerm, true, this.viewportY, this);\n490:   }\n491: \n492:   /**\n493:    * Parse a CSS color string to 0xRRGGBB format.\n494:    * Returns 0 if the color is undefined or invalid.\n495:    */\n496:   private parseColorToHex(color?: string): number {\n497:     if (!color) return 0;\n568:   /**\n569:    * Open terminal in a parent element\n570:    *\n571:    * Initializes all components and starts rendering.\n572:    * Requires a pre-loaded Ghostty instance passed to the constructor.\n573:    */\n574:   open(parent: HTMLElement): void {\n575:     if (this.isOpen) {\n576:       throw new Error('Terminal is already open');\n577:     }\n578:     if (this.isDisposed) {\n579:       throw new Error('Terminal has been disposed');\n602: \n603:       // Create WASM terminal with current dimensions and config\n604:       const config = this.buildWasmConfig();\n605:       this.wasmTerm = this.ghostty!.createTerminal(this.cols, this.rows, config);\n606: \n607:       // Create canvas element\n608:       this.canvas = document.createElement('canvas');\n609:       this.canvas.style.display = 'block';\n610:       parent.appendChild(this.canvas);\n611: \n612:       // Create hidden textarea for keyboard input (must be inside parent for event bubbling)\n613:       this.textarea = document.createElement('textarea');\n645:         textarea.focus();\n646:       });\n647: \n648:       // Create renderer\n649:       this.renderer = new CanvasRenderer(this.canvas, {\n650:         fontSize: this.options.fontSize,\n651:         fontFamily: this.options.fontFamily,\n652:         lineHeight: this.options.lineHeight,\n653:         cursorStyle: this.options.cursorStyle,\n654:         cursorBlink: this.options.cursorBlink,\n655:         theme: this.options.theme,\n656:       });\n657: \n658:       // Size canvas to terminal dimensions (use renderer.resize for proper DPI scaling)\n659:       this.renderer.resize(this.cols, this.rows);\n660: \n661:       // Create input handler\n662:       this.inputHandler = new InputHandler(\n663:         this.ghostty!,\n664:         parent,\n665:         (data: string) => {\n666:           // Check if stdin is disabled\n667:           if (this.options.disableStdin) {\n681:         this.customKeyEventHandler,\n682:         (mode: number) => {\n683:           // Query terminal mode state (e.g., mode 1 for application cursor mode)\n684:           return this.wasmTerm?.getMode(mode, false) ?? false;\n685:         },\n686:         // Paste events that bubble to the container must share Terminal.paste() with the textarea\n687:         // path, so bracketed mode and ESC stripping are applied identically and only once.\n688:         (text: string) => {\n689:           this.paste(text);\n690:         }\n691:       );\n692: \n693:       // Create selection manager (pass textarea for context menu positioning)\n694:       this.selectionManager = new SelectionManager(\n695:         this,\n696:         this.renderer,\n697:         this.wasmTerm,\n698:         this.textarea\n699:       );\n700: \n701:       // Connect selection manager to renderer\n702:       this.renderer.setSelectionManager(this.selectionManager);\n703: \n704:       // Forward selection change events\n705:       this.selectionManager.onSelectionChange(() => {\n706:         this.selectionChangeEmitter.fire();\n707:       });\n708: \n709:       // Setup paste event handler on textarea\n710:       this.textarea.addEventListener('paste', (e: ClipboardEvent) => {\n741:       parent.addEventListener('wheel', this.handleWheel, { passive: false, capture: true });\n742: \n743:       // Render initial blank screen (force full redraw)\n744:       this.renderer.render(this.wasmTerm, true, this.viewportY, this, this.scrollbarOpacity);\n745: \n746:       // Start render loop\n747:       this.observeVisibility(parent);\n748:     this.startRenderLoop();\n749: \n750:       // Focus input (auto-focus so user can start typing immediately)\n751:       this.focus();\n752:     } catch (error) {\n753:       // Clean up on error\n754:       this.isOpen = false;\n761:   /**\n762:    * Write data to terminal\n763:    */\n764:   write(data: string | Uint8Array, callback?: () => void): void {\n765:     this.assertOpen();\n766: \n767:     // Handle convertEol option\n768:     if (this.options.convertEol && typeof data === 'string') {\n769:       data = data.replace(/\\n/g, '\\r\\n');\n770:     }\n771: \n772:     this.writeInternal(data, callback);\n773:   }\n774: \n775:   /**\n776:    * Internal write implementation (extracted from write())\n777:    */\n778:   private writeInternal(data: string | Uint8Array, callback?: () => void): void {\n779:     // Note: We intentionally do NOT clear selection on write - most modern terminals\n780:     // preserve selection when new data arrives. Selection is cleared by user actions\n781:     // like clicking or typing, not by incoming data.\n782: \n783:     // Write directly to WASM terminal (handles VT parsing internally)\n784:     const wasAlternate = this.wasmTerm!.isAlternateScreen();\n785:     this.wasmTerm!.write(data);\n786:     this.revision++;\n787:     this.notifyBufferChangeIfSwitched(wasAlternate);\n788: \n789:     // Process any responses generated by the terminal (e.g., DSR cursor position)\n790:     // These need to be sent back to the PTY via onData\n791:     this.processTerminalResponses();\n792: \n793:     // Titles and the bell are not surfaced by the WASM API; one bounded streaming scanner handles\n805: \n806:     // Call callback if provided\n807:     if (callback) {\n808:       // Queue callback after next render\n809:       requestAnimationFrame(callback);\n810:     }\n811: \n812:     // Render will happen on next animation frame\n813:   }\n814: \n815:   /**\n816:    * Notify buffer subscribers when a write or reset switched between the normal and alternate screens.\n817:    * Comparing the before/after state ties the event to real transitions and avoids duplicate events.\n818:    */\n819:   private notifyBufferChangeIfSwitched(wasAlternate: boolean): void {\n820:     const isAlternate = this.wasmTerm?.isAlternateScreen() ?? false;\n821:     if (isAlternate === wasAlternate) return;\n822:     (this.buffer as BufferNamespace)._fireBufferChange(\n823:       isAlternate ? this.buffer.alternate : this.buffer.normal\n824:     );\n825:   }\n826: \n827:   /**\n828:    * Write data with newline\n829:    */\n830:   writeln(data: string | Uint8Array, callback?: () => void): void {\n831:     if (typeof data === 'string') {\n832:       this.write(data + '\\r\\n', callback);\n833:     } else {\n834:       // Append \\r\\n to Uint8Array\n835:       const newData = new Uint8Array(data.length + 2);\n836:       newData.set(data);\n837:       newData[data.length] = 0x0d; // \\r\n838:       newData[data.length + 1] = 0x0a; // \\n\n839:       this.write(newData, callback);\n840:     }\n841:   }\n842: \n843:   /**\n844:    * Paste text into terminal (triggers bracketed paste if supported)\n845:    */\n846:   paste(data: string): void {\n847:     this.assertOpen();\n852:     }\n853: \n854:     // Check if terminal has bracketed paste mode enabled\n855:     if (this.wasmTerm!.hasBracketedPaste()) {\n856:       // Strip ESC by default so a pasted \"\\x1b[201~\" cannot terminate the bracketed region early.\n857:       // This mirrors the native core (crates/akitty-core/src/session.rs input()).\n858:       const sanitized = data.replace(/\\x1b/g, '');\n859:       this.dataEmitter.fire('\\x1b[200~' + sanitized + '\\x1b[201~');\n860:     } else {\n861:       // Send data directly\n862:       this.dataEmitter.fire(data);\n863:     }\n882:       this.dataEmitter.fire(data);\n883:     } else {\n884:       // Just write to terminal without triggering onData\n885:       this.write(data);\n886:     }\n887:   }\n888: \n889:   /**\n890:    * Resize terminal\n891:    */\n892:   resize(cols: number, rows: number): void {\n893:     this.assertOpen();\n901:     this.rows = rows;\n902: \n903:     // Resize WASM terminal\n904:     this.wasmTerm!.resize(cols, rows);\n905:     this.revision++;\n906: \n907:     // Resize renderer\n908:     this.renderer!.resize(cols, rows);\n909: \n910:     // Update canvas dimensions\n911:     const metrics = this.renderer!.getMetrics();\n912:     this.canvas!.width = metrics.width * cols;\n913:     this.canvas!.height = metrics.height * rows;\n914:     this.canvas!.style.width = `${metrics.width * cols}px`;\n915:     this.canvas!.style.height = `${metrics.height * rows}px`;\n916: \n917:     // Fire resize event\n918:     this.resizeEmitter.fire({ cols, rows });\n919: \n920:     // Force full render\n921:     this.renderer!.render(this.wasmTerm!, true, this.viewportY, this);\n922:   }\n923: \n924:   /**\n925:    * Clear terminal screen\n926:    */\n927:   clear(): void {\n928:     this.assertOpen();\n929:     // Send ANSI clear screen and cursor home sequences\n930:     this.wasmTerm!.write('\\x1b[2J\\x1b[H');\n931:     this.revision++;\n932:   }\n933: \n934:   /**\n935:    * Reset terminal state\n936:    */\n937:   reset(): void {\n938:     this.assertOpen();"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c356","stream":{"kind":"session","id":"01a1a09f-24a4-7103-818d-aa6ddad7f330"},"sequence":5,"recorded_at":1780531400000006,"record_type":"event","durability":"durable","causation_id":"01a1a09f-2973-7440-a2ba-2f14b599cd50","payload_type":"run.lifecycle.started","payload_schema_version":1,"payload":{"kind":"run_started","command_id":"01a1a09f-2973-7440-a2ba-2f14b599cd50","run_stream":{"kind":"run","id":"01a1a09f-2973-7440-a2ba-2f14b599cd50"},"prompt":"Review AX Code Desktop for selective WebAssembly migration to improve performance and stability. This is assessment only, no implementation. Respond in English. Independently rank candidate kernels and no-go areas, cite provided file/symbol evidence, distinguish measured facts from hypotheses, discuss alternatives (incremental JS, workers, batching, native runtime), ABI/string/AST transfer costs, semantics compatibility, bounded failure recovery, deployment/CSP, and propose benchmark gates. Do not claim unmeasured speedups. Repository HEAD 86fed71500347e9878219c2b98d23abd52d7f8f8, version 7.30.12, Node 26.5.0. Desktop owns UI/control plane; runtime owns coding tools/repository intelligence, AX Agent owns durable runs, AX Trust owns credentials/policy. Never duplicate runtime or terminal upstream. Current AkiTTY Web 0.5.2 is a pinned canonical import from akitty commit 4daf16ce6cbb394a325b0f706779600bba045a83. Ghostty already uses WASM. Production CSP already permits wasm-unsafe-eval, not unsafe-eval. Markdown threshold 16384 code units, cap 1000000. Existing source has cooperative streaming coalescing, incremental turn projections, retention bounds and worker recovery; do not presume historical bugs remain. The following excerpts are curated source, not measured profiling. Files over 200 lines are sampled around relevant kernels, so identify uncertainty. No tools, shell, writing, delegation, or external lookups are necessary; review the supplied evidence and return a complete advisory report.\n\n\nFILE desktop/packages/ui/src/components/chat/markdownWorkerParser.ts\n1: import { unified } from \"unified\"\n2: import remarkParse from \"remark-parse\"\n3: import remarkGfm from \"remark-gfm\"\n4: import remarkMath from \"remark-math\"\n5: import type { Root } from \"mdast\"\n6: import { buildFullMarkdownBlock, buildLiveMarkdownBlocks, type LiveMarkdownLexCache } from \"./markdownStreamBlocks\"\n7: import type { MarkdownParseRequest, MarkdownParseResponse, ParsedMarkdownBlock } from \"./markdownWorkerProtocol\"\n8: \n9: const parser = unified().use(remarkParse).use(remarkGfm).use(remarkMath)\n10: \n11: const parseSyntax = (source: string): Root => parser.parse(source) as Root\n12: \n13: export const createMarkdownWorkerParser = (parse = parseSyntax) => {\n14:   // Retain only the last successful live request. Message changes, rewrites and\n15:   // finalization invalidate reuse; terminating the worker releases this cache.\n16:   let previous: { text: string; baseKey: string; lex: LiveMarkdownLexCache; blocks: ParsedMarkdownBlock[] } | null =\n17:     null\n18:   return (request: MarkdownParseRequest): ParsedMarkdownBlock[] => {\n19:     const reusable = request.live && previous?.baseKey === request.baseKey && request.text.startsWith(previous.text)\n20:     const oldBlocks = reusable ? previous!.blocks : []\n21:     const projected = request.live\n22:       ? buildLiveMarkdownBlocks(request.text, request.baseKey, reusable ? previous!.lex : null)\n23:       : null\n24:     const blocks = projected?.blocks ?? [buildFullMarkdownBlock(request.text, request.baseKey)]\n25:     const parsed = blocks.map((block, index) => {\n26:       const old = oldBlocks[index]\n27:       if (\n28:         block.mode === \"full\" &&\n29:         old?.mode === \"full\" &&\n30:         block.key === old.key &&\n31:         block.raw === old.raw &&\n32:         block.src === old.src\n33:       )\n34:         return old\n35:       // Detach completed substrings from prior request buffers. V8 sliced\n36:       // strings can otherwise retain many whole streaming snapshots. Copy UTF-16\n37:       // units directly so unfinished surrogate pairs are preserved as well.\n38:       const raw = block.mode === \"full\" ? block.raw.split(\"\").join(\"\") : block.raw\n39:       const src = block.mode === \"full\" ? (block.src === block.raw ? raw : block.src.split(\"\").join(\"\")) : block.src\n40:       return { ...block, raw, src, tree: parse(src) }\n41:     })\n42:     const stable = projected ? parsed.slice(0, projected.cache.stableBlocks.length) : []\n43:     if (projected) projected.cache.stableBlocks = stable\n44:     // The live tail is always parsed again; retaining its old AST would only\n45:     // increase peak memory during the next parse.\n46:     previous = projected ? { text: request.text, baseKey: request.baseKey, lex: projected.cache, blocks: stable } : null\n47:     return parsed\n48:   }\n49: }\n50: \n51: // Stateless entry point for parity checks and standalone parsing.\n52: export const parseMarkdownInWorker = (request: MarkdownParseRequest): ParsedMarkdownBlock[] =>\n53:   createMarkdownWorkerParser()(request)\n54: \n55: /** Omit unchanged blocks the receiver explicitly acknowledged; send the changed suffix. */\n56: export const createMarkdownWorkerResponder = () => {\n57:   const parse = createMarkdownWorkerParser()\n58:   let previous: { request: MarkdownParseRequest; blocks: ParsedMarkdownBlock[] } | null = null\n59:   return (request: MarkdownParseRequest): MarkdownParseResponse => {\n60:     const blocks = parse(request)\n61:     let stablePrefixCount = 0\n62:     if (\n63:       request.live &&\n64:       previous &&\n65:       request.ownerId !== undefined &&\n66:       request.ownerId === previous.request.ownerId &&\n67:       request.baseKey === previous.request.baseKey &&\n68:       request.baseRevision === previous.request.id\n69:     ) {\n70:       // The parser reuses references only for semantically stable blocks. A\n71:       // reference definition, rewrite, or final parse invalidates that reuse.\n72:       while (\n73:         stablePrefixCount < blocks.length &&\n74:         blocks[stablePrefixCount].mode === \"full\" &&\n75:         blocks[stablePrefixCount] === previous.blocks[stablePrefixCount]\n76:       )\n77:         stablePrefixCount++\n78:     }\n79:     const response: MarkdownParseResponse = {\n80:       id: request.id,\n81:       blocks: stablePrefixCount ? blocks.slice(stablePrefixCount) : blocks,\n82:       ...(stablePrefixCount ? { stablePrefixCount, baseRevision: previous!.request.id } : {}),\n83:     }\n84:     // One bounded response, shared with the parser, never a transcript cache.\n85:     previous = request.live ? { request, blocks } : null\n86:     return response\n87:   }\n88: }\n\nFILE desktop/packages/ui/src/components/chat/markdownWorkerClient.ts\n1: import {\n2:   MAX_WORKER_MARKDOWN_CHARACTERS,\n3:   type MarkdownParseRequest,\n4:   type MarkdownParseResponse,\n5:   type ParsedMarkdownBlock,\n6: } from \"./markdownWorkerProtocol\"\n7: \n8: type ResultHandler = (blocks: ParsedMarkdownBlock[] | null) => void\n9: type Job = { owner: object; request: MarkdownParseRequest; result: ResultHandler; released?: boolean }\n10: export type MarkdownWorker = Pick<Worker, \"postMessage\" | \"terminate\" | \"onmessage\" | \"onerror\" | \"onmessageerror\">\n11: export type MarkdownAdmission = \"queued\" | \"deferred\" | \"rejected\"\n12: \n13: const MAX_PENDING_JOBS = 16\n14: const MAX_RETAINED_CHARACTERS = 4_000_000\n15: const TIMEOUT_MS = 5_000\n16: const FAILURE_LIMIT = 3\n17: const RECOVERY_COOLDOWN_MS = 15_000\n18: \n19: // One active job, one latest pending job per owner, and one acknowledged\n20: // response. Deferred consumers retain their source in React, not in this queue.\n21: export class MarkdownWorkerClient {\n22:   private worker: MarkdownWorker | null = null\n23:   private active: Job | null = null\n24:   private pending = new Map<object, Job>()\n25:   private pendingCharacters = 0\n26:   private timer: ReturnType<typeof setTimeout> | null = null\n27:   private recoveryTimer: ReturnType<typeof setTimeout> | null = null\n28:   private nextId = 0\n29:   private nextOwnerId = 0\n30:   private ownerIds = new WeakMap<object, number>()\n31:   private failures = 0\n32:   private retryAt = 0\n33:   private capacityListeners = new Set<() => void>()\n34:   private capacityNotificationPending = false\n35:   private response: { owner: object; id: number; baseKey: string; blocks: ParsedMarkdownBlock[] } | null = null\n36: \n37:   constructor(private readonly createWorker: () => MarkdownWorker) {}\n38: \n39:   request(owner: object, input: Omit<MarkdownParseRequest, \"id\">, result: ResultHandler): MarkdownAdmission {\n40:     const previous = this.pending.get(owner)\n41:     if (input.text.length > MAX_WORKER_MARKDOWN_CHARACTERS) {\n42:       this.removePending(owner)\n43:       this.deliver({ owner, request: { ...input, id: 0 }, result }, null)\n44:       this.notifyCapacity()\n45:       return \"rejected\"\n46:     }\n47:     const retained =\n48:       this.pendingCharacters - (previous?.request.text.length ?? 0) + (this.active?.request.text.length ?? 0)\n49:     if (\n50:       Date.now() < this.retryAt ||\n51:       (!previous && this.pending.size >= MAX_PENDING_JOBS) ||\n52:       retained + input.text.length > MAX_RETAINED_CHARACTERS\n53:     ) {\n54:       this.removePending(owner)\n55:       this.deliver({ owner, request: { ...input, id: 0 }, result }, null)\n56:       if (previous) this.notifyCapacity()\n57:       return \"deferred\"\n58:     }\n59:     let ownerId = this.ownerIds.get(owner)\n60:     if (ownerId === undefined) this.ownerIds.set(owner, (ownerId = ++this.nextOwnerId))\n61:     this.pendingCharacters += input.text.length - (previous?.request.text.length ?? 0)\n62:     // Replacing a pending value keeps its queue position, preventing a rapidly\n63:     // changing owner from being moved behind every newly mounted consumer.\n64:     this.pending.set(owner, { owner, request: { ...input, ownerId, id: ++this.nextId }, result })\n65:     this.pump()\n66:     return \"queued\"\n67:   }\n68: \n69:   subscribeCapacity(listener: () => void): () => void {\n70:     this.capacityListeners.add(listener)\n71:     return () => {\n72:       this.capacityListeners.delete(listener)\n73:     }\n74:   }\n75: \n76:   release(owner: object) {\n77:     this.removePending(owner)\n78:     if (this.response?.owner === owner) this.response = null\n79:     if (this.active?.owner === owner) this.active.released = true\n80:     if (this.pending.size === 0 && (!this.active || this.active.released)) this.dispose()\n81:     this.notifyCapacity()\n82:   }\n83: \n84:   private removePending(owner: object) {\n85:     const previous = this.pending.get(owner)\n86:     if (previous) this.pendingCharacters -= previous.request.text.length\n87:     this.pending.delete(owner)\n88:   }\n89: \n90:   private notifyCapacity() {\n91:     if (this.capacityNotificationPending) return\n92:     this.capacityNotificationPending = true\n93:     queueMicrotask(() => {\n94:       this.capacityNotificationPending = false\n95:       for (const listener of [...this.capacityListeners]) {\n96:         try {\n97:           listener()\n98:         } catch (error) {\n99:           console.error(\"[markdown-worker] capacity listener failed\", error)\n100:         }\n101:       }\n102:     })\n103:   }\n104: \n105:   private deliver(job: Job, blocks: ParsedMarkdownBlock[] | null) {\n106:     if (job.released) return\n107:     try {\n108:       job.result(blocks)\n109:     } catch (error) {\n110:       console.error(\"[markdown-worker] result handler failed\", error)\n111:     }\n112:   }\n113: \n114:   private dispose() {\n115:     if (this.timer !== null) clearTimeout(this.timer)\n116:     this.timer = null\n117:     this.worker?.terminate()\n118:     this.worker = null\n119:     this.active = null\n120:     this.response = null\n121:   }\n122: \n123:   private fail() {\n124:     const failed = this.active\n125:     this.dispose()\n126:     this.failures++\n127:     if (this.failures >= FAILURE_LIMIT) {\n128:       this.retryAt = Date.now() + RECOVERY_COOLDOWN_MS\n129:       if (this.recoveryTimer !== null) clearTimeout(this.recoveryTimer)\n130:       this.recoveryTimer = setTimeout(() => {\n131:         this.recoveryTimer = null\n132:         this.retryAt = 0\n133:         this.pump()\n134:         this.notifyCapacity()\n135:       }, RECOVERY_COOLDOWN_MS)\n136:     }\n137:     // A poison job is settled once, never automatically retried. Other owners\n138:     // remain queued and can use a fresh worker; repeated faults pause spawning.\n139:     if (failed) this.deliver(failed, null)\n140:     if (Date.now() >= this.retryAt) this.pump()\n141:     this.notifyCapacity()\n142:   }\n143: \n144:   private complete(data: MarkdownParseResponse) {\n145:     const completed = this.active\n146:     if (!completed || data.id !== completed.request.id) return\n147:     const prefix = data.stablePrefixCount ?? 0\n148:     if (\n149:       !Number.isInteger(prefix) ||\n150:       prefix < 0 ||\n151:       (prefix > 0 &&\n152:         (!data.blocks ||\n153:           !this.response ||\n154:           this.response.owner !== completed.owner ||\n155:           this.response.baseKey !== completed.request.baseKey ||\n156:           this.response.id !== data.baseRevision ||\n157:           prefix > this.response.blocks.length))\n158:     ) {\n159:       this.fail()\n160:       return\n161:     }\n162:     const blocks = data.blocks && prefix ? [...this.response!.blocks.slice(0, prefix), ...data.blocks] : data.blocks\n163:     if (this.timer !== null) clearTimeout(this.timer)\n164:     this.timer = null\n165:     this.active = null\n166:     this.failures = 0\n167:     this.response =\n168:       blocks && completed.request.live && !completed.released\n169:         ? { owner: completed.owner, id: data.id, baseKey: completed.request.baseKey, blocks }\n170:         : null\n171:     this.deliver(completed, blocks)\n172:     this.pump()\n173:     this.notifyCapacity()\n174:   }\n175: \n176:   private pump() {\n177:     if (this.active || this.pending.size === 0 || Date.now() < this.retryAt) return\n178:     const job = this.pending.values().next().value!\n179:     this.removePending(job.owner)\n180:     this.active = job\n181:     try {\n182:       if (!this.worker) {\n183:         const worker = this.createWorker()\n184:         this.worker = worker\n185:         worker.onmessage = (event: MessageEvent<MarkdownParseResponse>) => {\n186:           if (this.worker === worker) this.complete(event.data)\n187:         }\n188:         worker.onerror = worker.onmessageerror = () => {\n189:           if (this.worker === worker) this.fail()\n190:         }\n191:       }\n192:       const baseRevision = this.response?.owner === job.owner ? this.response.id : undefined\n193:       this.timer = setTimeout(() => this.fail(), TIMEOUT_MS)\n194:       this.worker.postMessage({ ...job.request, baseRevision })\n195:     } catch {\n196:       this.fail()\n197:     }\n198:   }\n199: }\n200: \n201: export const markdownWorkerClient = new MarkdownWorkerClient(\n202:   () => new Worker(new URL(\"./markdownParser.worker.ts\", import.meta.url), { type: \"module\" }),\n203: )\n\nFILE desktop/packages/ui/src/components/chat/PreparedMarkdown.tsx\n1: import React from \"react\"\n2: import ReactMarkdown, { type Components } from \"react-markdown\"\n3: import remarkGfm from \"remark-gfm\"\n4: import remarkMath from \"remark-math\"\n5: import rehypeKatex from \"rehype-katex\"\n6: import type { Root } from \"mdast\"\n7: import type { Processor } from \"unified\"\n8: import type { ParsedMarkdownBlock } from \"./markdownWorkerProtocol\"\n9: \n10: // Install after the syntax extensions: reuse the worker's MDAST while keeping\n11: // ReactMarkdown's existing HAST conversion, URL filtering and custom components.\n12: function remarkPreparsed(this: Processor, tree: Root) {\n13:   this.parser = () => tree\n14: }\n15: \n16: // Pathologically nested or malformed Markdown can throw inside ReactMarkdown's\n17: // render (e.g. a stack overflow in remark). Show the original source instead of\n18: // taking down the whole chat boundary.\n19: class MarkdownRenderBoundary extends React.Component<{ raw: string; children: React.ReactNode }, { failed: boolean }> {\n20:   state = { failed: false }\n21: \n22:   static getDerivedStateFromError() {\n23:     return { failed: true }\n24:   }\n25: \n26:   componentDidUpdate(prevProps: { raw: string }) {\n27:     if (prevProps.raw !== this.props.raw && this.state.failed) {\n28:       this.setState({ failed: false })\n29:     }\n30:   }\n31: \n32:   render() {\n33:     if (this.state.failed) {\n34:       return <div className=\"whitespace-pre-wrap break-words\">{this.props.raw}</div>\n35:     }\n36:     return this.props.children\n37:   }\n38: }\n39: \n40: export const PreparedMarkdown = React.memo(\n41:   ({ block, components }: { block: ParsedMarkdownBlock; components: Components }) => {\n42:     if (block.plain) return <div className=\"whitespace-pre-wrap\">{block.raw}</div>\n43:     return (\n44:       <MarkdownRenderBoundary raw={block.raw}>\n45:         <ReactMarkdown\n46:           remarkPlugins={block.tree ? [remarkGfm, remarkMath, [remarkPreparsed, block.tree]] : [remarkGfm, remarkMath]}\n47:           rehypePlugins={[[rehypeKatex, { throwOnError: false, errorColor: \"var(--destructive)\" }]]}\n48:           components={components}\n49:         >\n50:           {block.src}\n51:         </ReactMarkdown>\n52:       </MarkdownRenderBoundary>\n53:     )\n54:   },\n55: )\n56: PreparedMarkdown.displayName = \"PreparedMarkdown\"\n\nFILE desktop/packages/ui/src/contexts/DiffWorkerProvider.tsx\n1: import React, { useMemo, useEffect, useRef, useState } from \"react\"\n2: import type { SupportedLanguages } from \"@pierre/diffs\"\n3: import type { WorkerPoolManager } from \"@pierre/diffs/worker\"\n4: \n5: import { useOptionalThemeSystem } from \"./useThemeSystem\"\n6: import { workerFactory } from \"@/lib/diff/workerFactory\"\n7: import { getDefaultTheme } from \"@/lib/theme/themes\"\n8: import { getAppThemeRegistrationId } from \"@/lib/shiki/textMateThemeFromAppTheme\"\n9: import type { Theme } from \"@/types/theme\"\n10: // NOTE: keep provider lightweight; avoid main-thread diff parsing here.\n11: \n12: // Preload common languages for faster initial diff rendering\n13: const PRELOAD_LANGS: SupportedLanguages[] = [\n14:   // Keep small; workers load others on-demand.\n15:   \"typescript\",\n16:   \"javascript\",\n17:   \"tsx\",\n18:   \"jsx\",\n19:   \"json\",\n20:   \"markdown\",\n21: ]\n22: \n23: interface DiffWorkerProviderProps {\n24:   children: React.ReactNode\n25: }\n26: \n27: type WorkerPoolStyle = \"unified\" | \"split\"\n28: \n29: const WORKER_POOL_CONFIG: Record<\n30:   WorkerPoolStyle,\n31:   { poolSize: number; totalASTLRUCacheSize: number; lineDiffType: \"none\" | \"word-alt\" }\n32: > = {\n33:   unified: {\n34:     poolSize: 1,\n35:     totalASTLRUCacheSize: 24,\n36:     lineDiffType: \"none\",\n37:   },\n38:   split: {\n39:     poolSize: 2,\n40:     totalASTLRUCacheSize: 56,\n41:     lineDiffType: \"word-alt\",\n42:   },\n43: }\n44: \n45: let unifiedWorkerPool: WorkerPoolManager | undefined\n46: let splitWorkerPool: WorkerPoolManager | undefined\n47: let unifiedWorkerPoolPromise: Promise<WorkerPoolManager | undefined> | undefined\n48: let splitWorkerPoolPromise: Promise<WorkerPoolManager | undefined> | undefined\n49: \n50: const createWorkerPool = async (style: WorkerPoolStyle): Promise<WorkerPoolManager | undefined> => {\n51:   if (typeof window === \"undefined\") {\n52:     return undefined\n53:   }\n54: \n55:   const { WorkerPoolManager: WorkerPoolManagerConstructor } = await import(\"@pierre/diffs/worker\")\n56:   const config = WORKER_POOL_CONFIG[style]\n57:   const pool = new WorkerPoolManagerConstructor(\n58:     {\n59:       workerFactory,\n60:       poolSize: config.poolSize,\n61:       totalASTLRUCacheSize: config.totalASTLRUCacheSize,\n62:     },\n63:     {\n64:       theme: {\n65:         light: \"pierre-light\",\n67:       },\n68:       langs: PRELOAD_LANGS,\n69:       lineDiffType: config.lineDiffType,\n70:       // Packaged app:// workers inherit a CSP that disallows WebAssembly compilation.\n71:       preferredHighlighter: \"shiki-js\",\n72:     },\n73:   )\n74:   void pool.initialize()\n75:   return pool\n76: }\n77: \n78: const getExistingWorkerPool = (style: WorkerPoolStyle): WorkerPoolManager | undefined => {\n79:   return style === \"split\" ? splitWorkerPool : unifiedWorkerPool\n80: }\n81: \n82: const ensureWorkerPool = (style: WorkerPoolStyle): Promise<WorkerPoolManager | undefined> => {\n83:   if (typeof window === \"undefined\") {\n84:     return Promise.resolve(undefined)\n85:   }\n86: \n87:   if (style === \"split\") {\n88:     if (splitWorkerPool) {\n89:       return Promise.resolve(splitWorkerPool)\n90:     }\n91:     splitWorkerPoolPromise ??= createWorkerPool(\"split\")\n92:       .then((pool) => {\n93:         splitWorkerPool = pool\n94:         return pool\n95:       })\n96:       .catch((error) => {\n97:         // Clear the cached promise so a later call can retry instead of\n98:         // permanently resolving to a rejected import.\n99:         splitWorkerPoolPromise = undefined\n100:         console.warn(\"[DiffWorkerProvider] Failed to create split worker pool:\", error)\n101:         return undefined\n102:       })\n103:     return splitWorkerPoolPromise\n104:   }\n105: \n106:   if (unifiedWorkerPool) {\n107:     return Promise.resolve(unifiedWorkerPool)\n108:   }\n109:   unifiedWorkerPoolPromise ??= createWorkerPool(\"unified\")\n110:     .then((pool) => {\n111:       unifiedWorkerPool = pool\n112:       return pool\n113:     })\n114:     .catch((error) => {\n115:       unifiedWorkerPoolPromise = undefined\n116:       console.warn(\"[DiffWorkerProvider] Failed to create unified worker pool:\", error)\n117:       return undefined\n118:     })\n119:   return unifiedWorkerPoolPromise\n120: }\n121: \n122: const syncPoolRenderTheme = (themes: { light: Theme; dark: Theme }) => {\n123:   // Only sync pools that already exist — never create them here.\n124:   if (!unifiedWorkerPool && !splitWorkerPool) {\n125:     return\n126:   }\n127: \n128:   const renderTheme = {\n129:     light: getAppThemeRegistrationId(themes.light),\n130:     dark: getAppThemeRegistrationId(themes.dark),\n131:   }\n132: \n133:   const apply = () => {\n134:     if (unifiedWorkerPool) {\n135:       void unifiedWorkerPool.setRenderOptions({\n136:         theme: renderTheme,\n137:         lineDiffType: WORKER_POOL_CONFIG.unified.lineDiffType,\n138:       })\n139:     }\n140:     if (splitWorkerPool) {\n141:       void splitWorkerPool.setRenderOptions({\n142:         theme: renderTheme,\n143:         lineDiffType: WORKER_POOL_CONFIG.split.lineDiffType,\n144:       })\n145:     }\n146:   }\n147: \n148:   // A pool rejects an id it has no loader for, and this warmup is a child: its effect\n149:   // (and the idle warm-up callback) can run before the provider registers the palette,\n150:   // which used to drop the sync silently and leave the workers on the old theme.\n157:     .catch(apply)\n158: }\n159: \n160: const WorkerPoolWarmup: React.FC<{\n161:   children: React.ReactNode\n162:   themes: { light: Theme; dark: Theme }\n163: }> = ({ children, themes }) => {\n164:   const themesRef = useRef(themes)\n165:   useEffect(() => {\n166:     themesRef.current = themes\n167:   }, [themes])\n168: \n170:   // loads the Shiki highlighter + preload languages inside the worker (a separate,\n171:   // chunk-split ~7MB payload); doing that during initial app load competes with\n172:   // first paint. Warm the pools once the main thread goes idle instead. If the\n173:   // user opens a diff before