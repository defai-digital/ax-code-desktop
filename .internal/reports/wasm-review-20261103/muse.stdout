  undefined,\n69:             data.errorCode === \"unavailable\",\n70:           )\n71:         else if (typeof data.output === \"string\" && data.output.length > 0) finish(undefined, data.output)\n72:         else finish(new MermaidRenderError(\"render\"))\n73:       }\n74:       current.onerror = () => finish(new MermaidRenderError(\"unavailable\"), undefined, true)\n75:       current.onmessageerror = () => finish(new MermaidRenderError(\"unavailable\"), undefined, true)\n76:       try {\n77:         current.postMessage({ id, request })\n78:       } catch {\n79:         finish(new MermaidRenderError(\"unavailable\"), undefined, true)\n80:       }\n81:     })\n82:   }\n83: \n84:   function inOfficial(request: MermaidRequest, signal: AbortSignal): Promise<string> {\n85:     // A deadline can release the queue, but cannot terminate DOM-dependent work.\n86:     // Do not overlap global Mermaid configuration until that work really settles.\n87:     if (officialPending) return Promise.reject(new MermaidRenderError(\"unavailable\"))\n88:     officialPending = true\n89:     const controller = new AbortController()\n90:     return new Promise((resolve, reject) => {\n91:       let settled = false\n92:       const finish = (error?: unknown, output?: string) => {\n93:         if (settled) return\n94:         settled = true\n95:         clearTimeout(timer)\n96:         signal.removeEventListener(\"abort\", abort)\n97:         if (error) reject(error)\n98:         else resolve(output ?? \"\")\n99:       }\n100:       const abort = () => {\n101:         controller.abort(signal.reason)\n102:         finish(signal.reason)\n103:       }\n104:       const timer = setTimeout(() => {\n105:         const error = new MermaidRenderError(\"timeout\")\n106:         controller.abort(error)\n107:         finish(error)\n108:       }, timeoutMs)\n109:       signal.addEventListener(\"abort\", abort, { once: true })\n110:       let operation: Promise<string>\n111:       try {\n112:         operation = renderOfficial(request, controller.signal)\n113:       } catch (error) {\n114:         officialPending = false\n115:         finish(error)\n116:         return\n117:       }\n118:       void operation.then(\n119:         (output) => {\n120:           officialPending = false\n121:           finish(undefined, output)\n122:         },\n123:         (error) => {\n124:           officialPending = false\n125:           finish(error)\n126:         },\n127:       )\n128:     })\n129:   }\n130: \n131:   async function drain() {\n132:     if (active) return\n133:     active = true\n134:     try {\n135:       while (queue.length) {\n136:         const job = queue.shift()!\n137:         try {\n138:           job.signal.throwIfAborted()\n139:           const capability = getMermaidCapability(job.request.source, job.request.mode)\n140:           const key = JSON.stringify(job.request)\n141:           let output = cache.get(key)\n142:           if (output === undefined) {\n143:             output =\n144:               capability.renderer === \"beautiful-mermaid\"\n145:                 ? await inWorker(job.request, job.signal)\n146:                 : await inOfficial(job.request, job.signal)\n147:             job.signal.throwIfAborted()\n148:             if (job.request.mode === \"svg\") output = sanitizeMermaidSvg(output)\n149:             if (!output || (job.request.mode === \"svg\" && !output.includes(\"<svg\")))\n150:               throw new MermaidRenderError(\"render\")\n151:             // Bound cache by source plus output, not only entry count.\n152:             if (key.length + output.length <= 1_000_000) {\n153:               cache.set(key, output)\n154:               cacheCharacters += key.length + output.length\n155:               while (cache.size > 32 || cacheCharacters > 2_000_000) {\n156:                 const oldest = cache.keys().next().value!\n157:                 cacheCharacters -= oldest.length + cache.get(oldest)!.length\n158:                 cache.dele