 return true\n20:   }\n21:   if (!target) {\n22:     return false\n23:   }\n24: \n25:   const mergedOptions = { ...DEFAULT_FUZZY_OPTIONS, ...options }\n26: \n27:   if (mergedOptions.preferSubstring && target.toLowerCase().includes(query.toLowerCase())) {\n28:     return true\n29:   }\n30: \n31:   const fuse = new Fuse([target], {\n32:     threshold: mergedOptions.threshold,\n33:     distance: mergedOptions.distance,\n34:     ignoreLocation: mergedOptions.ignoreLocation,\n35:   })\n36: \n37:   return fuse.search(query).length > 0\n38: }\n39: \n40: function getFuzzyMatchMask<T>(\n41:   items: T[],\n42:   query: string,\n43:   getText: (item: T) => string,\n44:   options?: FuzzySearchOptions,\n45: ): boolean[] {\n46:   if (!query) {\n47:     return items.map(() => true)\n48:   }\n49: \n50:   const mergedOptions = { ...DEFAULT_FUZZY_OPTIONS, ...options }\n51:   const queryLower = query.toLowerCase()\n52:   const matches = new Array(items.length).fill(false)\n53:   const fuzzyCandidateTexts: string[] = []\n54:   const fuzzyCandidateIndices: number[] = []\n55: \n56:   for (let i = 0; i < items.length; i++) {\n57:     const target = getText(items[i])\n58:     if (!target) {\n59:       continue\n60:     }\n61: \n62:     if (mergedOptions.preferSubstring && target.toLowerCase().includes(queryLower)) {\n63:       matches[i] = true\n64:       continue\n65:     }\n66: \n67:     fuzzyCandidateTexts.push(target)\n68:     fuzzyCandidateIndices.push(i)\n69:   }\n70: \n71:   if (fuzzyCandidateTexts.length === 0) {\n72:     return matches\n73:   }\n74: \n75:   const fuse = new Fuse(fuzzyCandidateTexts, {\n76:     threshold: mergedOptions.threshold,\n77:     distance: mergedOptions.distance,\n78:     ignoreLocation: mergedOptions.ignoreLocation,\n79:   })\n80: \n81:   for (const result of fuse.search(query)) {\n82:     matches[fuzzyCandidateIndices[result.refIndex]] = true\n83:   }\n84: \n85:   return matches\n86: }\n87: \n88: export function filterByFuzzyQuery<T>(\n89:   items: T[],\n90:   query: string,\n91:   getText: (item: T) => string,\n92:   options?: FuzzySearchOptions,\n93: ): T[] {\n94:   const matches = getFuzzyMatchMask(items, query, getText, options)\n95:   const matching: T[] = []\n96: \n97:   for (let i = 0; i < items.length; i++) {\n98:     if (matches[i]) {\n99:       matching.push(items[i])\n100:     }\n101:   }\n102: \n103:   return matching\n104: }\n105: \n106: /**\n107:  * Score-sorted fuzzy ranking. Strict (low threshold), prioritizes substring\n108:  * matches (especially prefix matches), and returns the top N.\n109:  *\n110:  * Use this for command-palette-style result ranking where order matters more\n111:  * than recall.\n112:  */\n113: export function scoreByFuzzyQuery<T>(\n114:   items: T[],\n115:   query: string,\n116:   getText: (item: T) => string,\n117:   options?: { limit?: number; threshold?: number; noFuzzy?: boolean },\n118: ): { item: T; score: number }[] {\n119:   if (!query) return items.map((item) => ({ item, score: 0 }))\n120:   const limit = options?.limit ?? items.length\n121:   const threshold = options?.threshold ?? 0.3\n122:   const noFuzzy = options?.noFuzzy ?? false\n123:   const queryLower = query.toLowerCase()\n124: \n125:   const scored: { item: T; score: number }[] = []\n126:   const fuzzyCandidates: { item: T; text: string }[] = []\n127: \n128:   for (const item of items) {\n129:     const text = getText(item)\n130:     if (!text) continue\n131:     const lower = text.toLowerCase()\n132:     const idx = lower.indexOf(queryLower)\n133:     if (idx === 0) {\n134:       scored.push({ item, score: -1 })\n135:       continue\n136:     }\n137:     if (idx > 0) {\n138:       scored.push({ item, score: idx / 1000 })\n139:       continue\n140:     }\n141:     if (!noFuzzy) fuzzyCandidates.push({ item, text })\n142:   }\n143: \n144:   if (fuzzyCandidates.length > 0) {\n145:     const fuse = new Fuse(\n146:       fuzzyCandidates.map((c) => c.text),\n147:       { threshold, ignoreLocation: true, distance: 100, includeScore: true, minMatchCharLength: 2 },\n148:     )\n149:     for (const result of fuse.search(query)) {\n150:       scored.push({ item: fuzzyCandidates[result.refIndex].item, score: result.score ?? 1 })\n151:     }\n152:   }\n153: \n154:   scored.sort((a, b) => a.score - b.score)\n155:   return scored.slice(0, limit)\n156: }\n157: \n158: export function partitionByFuzzyQuery<T>(\n159:   items: T[],\n160:   query: string,\n161:   getText: (item: T) => string,\n162:   options?: FuzzySearchOptions,\n163: ): { matching: T[]; other: T[] } {\n164:   const matches = getFuzzyMatchMask(items, query, getText, options)\n165:   const matching: T[] = []\n166:   const other: T[] = []\n167: \n168:   for (let i = 0; i < items.length; i++) {\n169:     if (matches[i]) {\n170:       matching.push(items[i])\n171:       continue\n172:     }\n173:     other.push(items[i])\n174:   }\n175: \n176:   return { matching, other }\n177: }\n\nFILE desktop/packages/ui/src/components/views/WikiGraphView.tsx\n1: import React from \"react\"\n2: import type { WikiMaintenanceStatus } from \"@defai-digital/ax-code-sdk/v2\"\n3: \n4: import { Button } from \"@/components/ui/button\"\n5: import { useEffectiveDirectory } from \"@/hooks/useEffectiveDirectory\"\n6: import { useI18n, type I18nKey } from \"@/lib/i18n\"\n7: import { invokeDesktop } from \"@/lib/desktop\"\n8: import { classifyWikiViewerResult, type WikiMaintenanceDisabledReason, type WikiViewerFailure } from \"@/lib/wiki/api\"\n9: import { isWikiMaintenanceActive } from \"@/lib/wiki/snapshot\"\n10: \n11: import { useWikiGraph } from \"./wiki/useWikiGraph\"\n12: \n13: const PHASE_KEY = {\n14:   queued: \"wiki.graph.phase.queued\",\n15:   running: \"wiki.graph.phase.running\",\n16: } as const\n17: \n18: function disabledReasonKey(reason: WikiMaintenanceDisabledReason): I18nKey {\n19:   if (reason === \"permissions\") return \"wiki.graph.maintenance.permissions\"\n20:   if (reason === \"non_git\") return \"wiki.graph.maintenance.nonGit\"\n21:   // The runtime's unattached fallback (reason \"disabled\") means maintenance has not\n22:   // started, not that the project cannot maintain a wiki.\n23:   return \"wiki.graph.maintenance.disabled\"\n24: }\n25: \n26: /** One message per banner state; a failed phase uses its actionable hint instead of a label. */\n27: function maintenanceBannerKey(status: WikiMaintenanceStatus): I18nKey | null {\n28:   if (status.phase === \"ready\") return null\n29:   if (status.phase === \"disabled\") {\n30:     if (status.reason === \"permissions\") return disabledReasonKey(\"permissions\")\n31:     if (status.reason === \"non_git\") return disabledReasonKey(\"non_git\")\n32:     return disabledReasonKey(\"disabled\")\n33:   }\n34:   if (status.phase === \"failed\") return \"wiki.graph.maintenance.failed\"\n35:   return PHASE_KEY[status.phase]\n36: }\n37: \n38: function MaintenanceBanner({ status }: { status: WikiMaintenanceStatus | null }) {\n39:   const { t } = useI18n()\n40:   const key = status ? maintenanceBannerKey(status) : null\n41:   if (!status || !key) return null\n42:   const active = isWikiMaintenanceActive(status)\n43:   return (\n44:     <div className=\"flex items-center gap-2 border-b border-border/40 px-2 py-1 typography-micro text-muted-foreground\">\n45:       <span>{t(key)}</span>\n46:       {active && status.total > 0 ? (\n47:         <span>{t(\"wiki.graph.progress\", { completed: status.completed, total: status.total })}</span>\n48:       ) : null}\n49:     </div>\n50:   )\n51: }\n52: \n53: type ActionFailure =\n54:   | { kind: \"build\" }\n55:   | { kind: \"refresh\" }\n56:   | { kind: \"maintenance\"; reason: WikiMaintenanceDisabledReason }\n57:   | { kind: \"viewer\"; failure: WikiViewerFailure }\n58: \n59: function viewerFailureKey(failure: WikiViewerFailure): I18nKey {\n60:   if (failure === \"runtime_unavailable\") return \"wiki.graph.viewerRuntimeUnavailable\"\n61:   if (failure === \"wiki_missing\") return \"wiki.graph.viewerMissingWiki\"\n62:   if (failure === \"export_incompatible\") return \"wiki.graph.viewerIncompatible\"\n63:   return \"wiki.graph.viewerFailed\"\n64: }\n65: \n66: function actionFailureKey(failure: ActionFailure): I18nKey {\n67:   if (failure.kind === \"build\") return \"wiki.graph.buildFailed\"\n68:   if (failure.kind === \"refresh\") return \"wiki.graph.refreshFailed\"\n69:   if (failure.kind === \"maintenance\") return disabledReasonKey(failure.reason)\n70:   return viewerFailureKey(failure.failure)\n71: }\n72: \n73: const WikiGraphPanel: React.FC<{ directory: string }> = ({ directory }) => {\n74:   const { t } = useI18n()\n75:   const { load, maintenance, refreshing, requestRefresh } = useWikiGraph(directory)\n76:   const [actionError, setActionError] = React.useState<ActionFailure | null>(null)\n77:   const [opening, setOpening] = React.useState(false)\n78:   const graph = load?.status === \"graph\" ? load.graph : null\n79:   const openViewer = async () => {\n80:     setOpening(true)\n81:     setActionError(null)\n82:     try {\n83:       const result = classifyWikiViewerResult(await invokeDesktop(\"desktop_open_wiki_viewer\", { directory }))\n84:       if (!result.opened) setActionError({ kind: \"viewer\", failure: result.failure })\n85:     } catch {\n86:       setActionError({ kind: \"viewer\", failure: \"failed\" })\n87:     } finally {\n88:       setOpening(false)\n89:     }\n90:   }\n91: \n92:   const runRefresh = async (source: \"build\" | \"refresh\") => {\n93:     setActionError(null)\n94:     const outcome = await requestRefresh()\n95:     if (outcome.status === \"started\") return\n96:     // A disabled runtime status is not a transport failure: say why nothing was queued.\n97:     if (outcome.status === \"disabled\") setActionError({ kind: \"maintenance\", reason: outcome.reason })\n98:     else setActionError({ kind: source })\n99:   }\n100: \n101:   if (load === null) {\n102:     return (\n103:       <div className=\"flex h-full items-center justify-center p-6\" aria-busy=\"true\">\n104:         <p className=\"typography-ui-label text-muted-foreground\">{t(\"wiki.graph.loading\")}</p>\n105:       </div>\n106:     )\n107:   }\n108: \n109:   if (!graph) {\n110:     const message =\n111:       load.status === \"missing\"\n112:         ? t(\"wiki.graph.emptyBody\")\n113:         : load.status === \"too_large\"\n114:           ? t(\"wiki.graph.tooLarge\")\n115:           : t(\"wiki.graph.error\")\n116:     return (\n117:       <div className=\"flex h-full flex-col\">\n118:         <MaintenanceBanner status={maintenance} />\n119:         <div className=\"flex flex-1 flex-col items-center justify-center gap-3 p-6 text-center\">\n120:           {load.status === \"missing\" ? (\n121:             <h2 className=\"typography-ui-label text-foreground\">{t(\"wiki.graph.emptyTitle\")}</h2>\n122:           ) : null}\n123:           <p className=\"max-w-sm typography-micro text-muted-foreground\">{message}</p>\n124:           {actionError ? (\n125:             <p className=\"typography-micro text-[var(--status-warning)]\">{t(actionFailureKey(actionError))}</p>\n126:           ) : null}\n127:           <Button\n128:             variant=\"outline\"\n129:             size=\"sm\"\n130:             disabled={refreshing}\n131:             onClick={() => void runRefresh(load.status === \"missing\" ? \"build\" : \"refresh\")}\n132:           >\n133:             {load.status === \"missing\" ? t(\"wiki.graph.build\") : t(\"wiki.graph.refresh\")}\n134:           </Button>\n135:         </div>\n136:       </div>\n137:     )\n138:   }\n139: \n140:   return (\n141:     <div className=\"flex h-full flex-col bg-background\">\n142:       <MaintenanceBanner status={maintenance} />\n143:       <div className=\"flex flex-1 flex-col items-center justify-center gap-3 p-6 text-center\">\n144:         <h2 className=\"typography-ui-label\">{t(\"wiki.graph.title\")}</h2>\n145:         <p className=\"max-w-sm typography-micro text-muted-foreground\">{t(\"wiki.graph.viewerDescription\")}</p>\n146:         <Button disabled={opening} onClick={() => void openViewer()}>\n147:           {t(\"wiki.graph.openViewer\")}\n148:         </Button>\n149:         <Button variant=\"outline\" size=\"sm\" disabled={refreshing} onClick={() => void runRefresh(\"refresh\")}>\n150:           {t(\"wiki.graph.refresh\")}\n151:         </Button>\n152:         {actionError ? (\n153:           <p role=\"alert\" className=\"typography-micro text-[var(--status-warning)]\">\n154:             {t(actionFailureKey(actionError))}\n155:           </p>\n156:         ) : null}\n157:       </div>\n158:     </div>\n159:   )\n160: }\n161: \n162: export const WikiGraphView: React.FC = () => {\n163:   const { t } = useI18n()\n164:   const directory = useEffectiveDirectory()\n165:   if (!directory) {\n166:     return (\n167:       <div className=\"flex h-full items-center justify-center bg-background p-6 text-center\">\n168:         <p className=\"typography-ui-label text-muted-foreground\">{t(\"wiki.graph.noDirectory\")}</p>\n169:       </div>\n170:     )\n171:   }\n172:   return <WikiGraphPanel key={directory} directory={directory} />\n173: }\n\nFILE desktop/packages/ui/src/components/chat/mermaidRenderer.ts\n1: import { sanitizeMermaidSvg } from \"./sanitizeSvg\"\n2: import {\n3:   getMermaidCapability,\n4:   mermaidCapabilities,\n5:   MermaidRenderError,\n6:   type MermaidRequest,\n7:   type MermaidWorkerResponse,\n8: } from \"./mermaidProtocol\"\n9: \n10: type Job = {\n11:   request: MermaidRequest\n12:   signal: AbortSignal\n13:   resolve: (output: string) => void\n14:   reject: (error: unknown) => void\n15: }\n16: \n17: // One active layout bounds CPU/memory, preserves Mermaid's global configuration,\n18: // and avoids creating one worker for every diagram in a long transcript.\n19: export function createMermaidRenderer({\n20:   createWorker = () => new Worker(new URL(\"./mermaidRenderer.worker.ts\", import.meta.url), { type: \"module\" }),\n21:   renderOfficial =