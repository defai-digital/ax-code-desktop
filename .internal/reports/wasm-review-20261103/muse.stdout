a same-length edit in the middle of the\n121:   // file on the old key, and the diff view then showed stale lines. fnv1a32\n122:   // over the full text is still trivial next to the diff render it keys.\n123:   return `${contents.length}:${fnv1a32(contents)}`\n124: }\n125: \n126: const extractSelectedCode = (original: string, modified: string, range: SelectedLineRange): string => {\n127:   // Default to modified if side is ambiguous, as users mostly comment on new code\n128:   const isOriginal = range.side === \"deletions\"\n129:   const content = isOriginal ? original : modified\n130:   const lines = content.split(\"\\n\")\n227:   modified,\n228:   language,\n229:   fileName,\n230:   renderSideBySide,\n231:   wrapLines,\n232:   layout = \"fill\",\n233: }) => {\n234:   const registerThreadContent = React.useContext(RegisterReviewThreadContentContext)\n235:   useEffect(() => {\n236:     if (fileName) return registerThreadContent?.(fileName, { original, modified })\n237:   }, [fileName, original, modified, registerThreadContent])\n238:   const threadDirectory = useEffectiveDirectory()\n239:   const directoryThreads = useReviewThreadStore((state) =>\n240:     selectReviewThreads(state, threadDirectory ?? null),\n241:   )\n242:   // Open threads on this file follow the code they were written about; outdated ones stay in the thread list.\n243:   const anchoredThreads = useMemo<AnchoredReviewThread[]>(() => {\n244:     if (!fileName) return []\n245:     const result: AnchoredReviewThread[] = []\n246:     for (const thread of directoryThreads) {\n247:       if (thread.status !== \"open\" || thread.fileLabel !== fileName) continue\n248:       const anchor = reanchorThread(thread.code, thread.side === \"original\" ? original : modified, thread.startLine)\n249:       if (anchor.status === \"anchored\") result.push({ thread, startLine: anchor.startLine, endLine: anchor.endLine })\n250:     }\n251:     return result\n343:     cancel()\n344:   }, [cancel])\n345: \n346:   const r