ion = renderOfficial(request, controller.signal)\n113:       } catch (error) {\n114:         officialPending = false\n115:         finish(error)\n116:         return\n117:       }\n118:       void operation.then(\n119:         (output) => {\n120:           officialPending = false\n121:           finish(undefined, output)\n122:         },\n123:         (error) => {\n124:           officialPending = false\n125:           finish(error)\n126:         },\n127:       )\n128:     })\n129:   }\n130: \n131:   async function drain() {\n132:     if (active) return\n133:     active = true\n134:     try {\n135:       while (queue.length) {\n136:         const job = queue.shift()!\n137:         try {\n138:           job.signal.throwIfAborted()\n139:           const capability = getMermaidCapability(job.request.source, job.request.mode)\n140:           const key = JSON.stringify(job.request)\n141:           let output = cache.get(key)\n142:           if (output === undefined) {\n143:             output =\n144:               capability.renderer === \"beautiful-mermaid\"\n145:                 ? await inWorker(job.request, job.signal)\n146:                 : await inOfficial(job.request, job.signal)\n147:             job.signal.throwIfAborted()\n148:             if (job.request.mode === \"svg\") output = sanitizeMermaidSvg(output)\n149:             if (!output || (job.request.mode === \"svg\" && !output.includes(\"<svg\")))\n150:               throw new MermaidRenderError(\"render\")\n151:             // Bound cache by source plus output, not only entry count.\n152:             if (key.length + output.length <= 1_000_000) {\n153:               cache.set(key, output)\n154:               cacheCharacters += key.length + output.length\n155:               while (cache.size > 32 || cacheCharacters > 2_000_000) {\n156:                 const oldest = cache.keys().next().value!\n157:                 cacheCharacters -= oldest.length + cache.get(oldest)!.length\n158:                 cache.delete(oldest)\n159:               }\n160:             }\n161:           }\n162:           job.signal.throwIfAborted()\n163:           job.resolve(output)\n164:         } catch (error) {\n165:           job.reject(error)\n166:         }\n167:       }\n168:     } finally {\n169:       active = false\n170:     }\n171:   }\n172: \n173:   return (request: MermaidRequest, signal: AbortSignal): Promise<string> => {\n174:     if (signal.aborted) return Promise.reject(signal.reason)\n175:     if (queue.length >= 32) return Promise.reject(new MermaidRenderError(\"busy\"))\n176:     return new Promise((resolve, reject) => {\n177:       const job = { request, signal, resolve, reject }\n178:       // Remove obsolete streaming/theme/unmounted jobs before they consume layout time.\n179:       const abort = () => {\n180:         const index = queue.indexOf(job)\n181:         if (index >= 0) queue.splice(index, 1)\n182:         reject(signal.reason)\n183:       }\n184:       signal.addEventListener(\"abort\", abort, { once: true })\n185:       job.resolve = (output) => {\n186:         signal.removeEventListener(\"abort\", abort)\n187:         resolve(output)\n188:       }\n189:       job.reject = (error) => {\n190:         signal.removeEventListener(\"abort\", abort)\n191:         reject(error)\n192:       }\n193:       queue.push(job)\n194:       void drain()\n195:     })\n196:   }\n197: }\n198: \n199: export const renderMermaidDiagram = createMermaidRenderer()\n\nFILE desktop/packages/ui/src/components/chat/mermaidOfficialRenderer.ts\n1: import { MermaidRenderError, mermaidCapabilities, type MermaidRequest } from \"./mermaidProtocol\"\n2: \n3: let sequence = 0\n4: \n5: // The caller serializes jobs: Mermaid's initialize/render configuration is global.\n6: // This module and the diagram-specific bundles are loaded only for extended SVG types.\n7: export async function renderOfficialMermaid(request: MermaidRequest, signal: AbortSignal): Promise<string> {\n8:   const { default: mermaid } = await import(\"mermaid\")\n9:   signal.throwIfAborted()\n10:   mermaid.initialize({\n11:     startOnLoad: false,\n12:     securityLevel: \"strict\",\n13:     suppressErrorRendering: true,\n14:     maxTextSize: mermaidCapabilities.maxSourceCharacters,\n15:     maxEdges: 300,\n16:     theme: request.dark ? \"dark\" : \"default\",\n17:     themeVariables: {\n18:       background: request.colors.bg ?? (request.dark ? \"#18181b\" : \"#ffffff\"),\n19:       textColor: request.colors.fg ?? (request.dark ? \"#fafafa\" : \"#27272a\"),\n20:       pieTitleTextColor: request.colors.fg ?? (request.dark ? \"#fafafa\" : \"#27272a\"),\n21:       pieLegendTextColor: request.colors.fg ?? (request.dark ? \"#fafafa\" : \"#27272a\"),\n22:       pieSectionTextColor: request.dark ? \"#111827\" : \"#ffffff\",\n23:       // Mermaid's default dark pie palette is nearly black. Keep categories and\n24:       // their percentage labels distinguishable on the desktop's dark surfaces.\n25:       ...Object.fromEntries(\n26:         (request.dark\n27:           ? [\n28:               \"#60a5fa\",\n29:               \"#34d399\",\n30:               \"#fbbf24\",\n31:               \"#c084fc\",\n32:               \"#fb7185\",\n33:               \"#22d3ee\",\n34:               \"#a3e635\",\n35:               \"#fb923c\",\n36:               \"#a5b4fc\",\n37:               \"#f472b6\",\n38:               \"#2dd4bf\",\n39:               \"#d4d4d8\",\n40:             ]\n41:           : [\n42:               \"#2563eb\",\n43:               \"#047857\",\n44:               \"#b45309\",\n45:               \"#7e22ce\",\n46:               \"#be123c\",\n47:               \"#0e7490\",\n48:               \"#4d7c0f\",\n49:               \"#c2410c\",\n50:               \"#4338ca\",\n51:               \"#be185d\",\n52:               \"#0f766e\",\n53:               \"#52525b\",\n54:             ]\n55:         ).map((color, index) => [`pie${index + 1}`, color]),\n56:       ),\n57:     },\n58:     fontFamily: \"Inter, sans-serif\",\n59:     htmlLabels: false,\n60:     flowchart: { htmlLabels: false },\n61:   })\n62:   // Validate before creating DOM; parser failures must not leave error SVGs in the page.\n63:   try {\n64:     await mermaid.parse(request.source)\n65:   } catch (error) {\n66:     throw new MermaidRenderError(\"render\", error instanceof Error ? error.message : String(error))\n67:   }\n68:   signal.throwIfAborted()\n69:   const container = document.createElement(\"div\")\n70:   container.style.cssText = \"position:fixed;left:-100000px;top:0;visibility:hidden;pointer-events:none\"\n71:   container.setAttribute(\"aria-hidden\", \"true\")\n72:   document.body.append(container)\n73:   const removeContainer = () => container.remove()\n74:   signal.addEventListener(\"abort\", removeContainer, { once: true })\n75:   try {\n76:     const { svg } = await mermaid.render(`ax-mermaid-${++sequence}`, request.source, container)\n77:     signal.throwIfAborted()\n78:     return svg\n79:   } catch (error) {\n80:     if (signal.aborted) throw signal.reason\n81:     throw new MermaidRenderError(\"render\", error instanceof Error ? error.message : String(error))\n82:   } finally {\n83:     signal.removeEventListener(\"abort\", removeContainer)\n84:     container.remove()\n85:   }\n86: }\n\nFILE desktop/packages/ui/src/sync/materialization.ts\n1: import type { Message, Part } from \"@defai-digital/ax-code-sdk/v2/client\"\n2: import { mergeMessages, keepCompletedMessageOnMerge } from \"./optimistic\"\n3: import { shouldPreserveExistingPart } from \"./event-reducer\"\n4: import { compareIds, sortPartsById } from \"./part-ordering\"\n5: import type { PartMap } from \"./part-map\"\n6: \n7: const STREAMING_PART_FIELDS = [\"text\", \"output\"] as const\n8: \n9: type MaterializedMessageRecord = {\n10:   info: Message\n11:   parts: Part[]\n12: }\n13: \n14: type MaterializedState = {\n15:   message: Record<string, Message[]>\n16:   part: PartMap\n17: }\n18: \n19: type MaterializeSessionSnapshotsOptions = {\n20:   skipPartTypes?: ReadonlySet<string>\n21:   mode?: \"merge\" | \"prepend\"\n22:   before?: MaterializedState\n23: }\n24: \n25: type MaterializeSessionSnapshotsResult = {\n26:   message: Record<string, Message[]>\n27:   part: PartMap\n28:   messages: Message[]\n29:   messagesChanged: boolean\n30:   partsChanged: boolean\n31: }\n32: \n33: type SessionMaterializationStatus = {\n34:   hasMessages: boolean\n35:   renderable: boolean\n36:   missingPartMessageIDs: string[]\n37: }\n38: \n39: function partSnapshotKey(part: Part): string {\n40:   return JSON.stringify(part)\n41: }\n42: \n43: function haveEquivalentPartSnapshots(left: Part[] | undefined, right: Part[]): boolean {\n44:   if (!left) return right.length === 0\n45:   if (left.length !== right.length) return false\n46: \n47:   for (let index = 0; index < left.length; index += 1) {\n48:     const leftPart = left[index]\n49:     const rightPart = right[index]\n50:     if (!leftPart || !rightPart) return false\n51:     if (leftPart.id !== rightPart.id) return false\n52:     if (partSnapshotKey(leftPart) !== partSnapshotKey(rightPart)) return false\n53:   }\n54: \n55:   return true\n56: }\n57: \n58: function getPartEndTime(part: Part): number | undefined {\n59:   const stateEnd = (part as { state?: { time?: { end?: unknown } } }).state?.time?.end\n60:   if (typeof stateEnd === \"number\") {\n61:     return stateEnd\n62:   }\n63: \n64:   const timeEnd = (part as { time?: { end?: unknown } }).time?.end\n65:   return typeof timeEnd === \"number\" ? timeEnd : undefined\n274:     } else {\n275:       // Store fetched-empty as an explicit [] (not absence): an assistant message the\n276:       // server returned with zero parts (e.g. aborted before any output) is\n277:       // authoritatively empty and must count as renderable, or the ensure-renderable\n278:       // callers retry the sync forever.\n279:       nextPartState.set(messageID, nextParts)\n280:     }\n281:     partsChanged = true\n282:   }\n283: \n284:   return {\n285:     message: messagesChanged ? { ...state.message, [sessionID]: messages } : state.message,\n296: ): SessionMaterializationStatus {\n297:   const messages = state.message[sessionID]\n298:   if (!messages) {\n299:     return { hasMessages: false, renderable: false, missingPartMessageIDs: [] }\n300:   }\n301: \n302:   const missingPartMessageIDs: string[] = []\n303:   for (const message of messages) {\n304:     if (message.role !== \"assistant\") continue\n305:     // `undefined` = parts never fetched (not renderable yet). An explicit [] is a\n306:     // fetched-empty snapshot (e.g. aborted assistant turn) and counts as renderable —\n307:     // otherwise sessions containing such a message can never reach renderable state\n308:     // and ensure-renderable callers loop forever.\n309:     const parts = state.part.get(message.id)\n310:     if (!parts) {\n311:       missingPartMessageIDs.push(message.id)\n312:     }\n313:   }\n314: \n315:   return {\n316:     hasMessages: true,\n317:     renderable: missingPartMessageIDs.length === 0,\n318:     missingPartMessageIDs,\n319:   }\n320: }\n\nFILE desktop/packages/akitty-web/lib/ghostty.ts\n1: /**\n2:  * TypeScript wrapper for libghostty-vt WASM API\n3:  *\n4:  * High-performance terminal emulation using Ghostty's battle-tested VT100 parser.\n5:  * The key optimization is the RenderState API which provides a pre-computed\n6:  * snapshot of all render data in a single update call.\n7:  */\n8: \n9: import { graphemeString } from './codepoint';\n10: import {\n11:   CellFlags,\n12:   type Cursor,\n13:   DirtyState,\n14:   GHOSTTY_CONFIG_SIZE,\n15:   type GhosttyCell,\n16:   type GhosttyTerminalConfig,\n17:   type GhosttyWasmExports,\n18:   KeyEncoderOption,\n19:   type KeyEvent,\n20:   type KittyKeyFlags,\n21:   type RGB,\n22:   type RenderStateColors,\n23:   type RenderStateCursor,\n24:   type TerminalHandle,\n25: } from './types';\n26: \n27: // Re-export types for convenience\n28: export {\n29:   CellFlags,\n30:   type Cursor,\n31:   DirtyState,\n32:   type GhosttyCell,\n33:   type GhosttyTerminalConfig,\n34:   KeyEncoderOption,\n35:   type RGB,\n36:   type RenderStateColors,\n37:   type RenderStateCursor,\n38: };\n39: \n40: /**\n41:  * Main Ghostty WASM wrapper class\n42:  */\n43: export class Ghostty {\n44:   private exports: GhosttyWasmExports;\n45:   private memory: WebAssembly.Memory;\n46: \n47:   constructor(wasmInstance: WebAssembly.Instance) {\n48:     this.exports = wasmInstance.exports as GhosttyWasmExports;\n49:     this.memory = this.exports.memory;\n50:   }\n51: \n52:   createKeyEncoder(): KeyEncoder {\n53:     return new KeyEncoder(this.exports);\n54:   }\n55: \n56:   createTerminal(\n57:     cols: number = 80,\n58:     rows: number = 24,\n59:     config?: GhosttyTerminalConfig\n60:   ): GhosttyTerminal {\n61:     return new GhosttyTerminal(this.exports, this.memory, cols, rows, config);\n62:   }\n63: \n64:   static async load(wasmPath?: string): Promise<Ghostty> {\n65:     // If explicit path provided, use it\n66:     if (wasmPath) {\n67:       return Ghostty.loadFromPath(wasmPath);\n68:     }\n69: \n70:     // Resolve path relative to this module\n71:     const moduleUrl = new URL('../ghostty-vt.wasm', import.meta.url);\n72: \n73:     // Build paths to try, prioritizing file system paths for Node/Bun\n74:     const defaultPaths: string[] = [];\n75: \n76:     // For Node/Bun: try absolute file path first (strip file:// protocol)\n77:     if (moduleUrl.protocol === 'file:') {\n78:       let filePath = moduleUrl.pathname;\n79:       // Remove leading slash on Windows paths (e.g., /C:/ -> C:/)\n84:     }\n85: \n86:     // Also try other common paths\n87:     defaultPaths.push(moduleUrl.href, './ghostty-vt.wasm', '/ghostty-vt.wasm');\n88: \n89:     let lastError: Error | null = null;\n90:     for (const path of defaultPaths) {\n91:       try {\n92:         return await Ghostty.loadFromPath(path);\n93:       } catch (e) {\n94:         lastError = e instanceof Error ? e : new Error(String(e));\n95:       }\n98:   }\n99: \n100:   private static async loadFromPath(path: string): Promise<Ghostty> {\n101:     let wasmBytes: ArrayBuffer | undefined;\n102: \n103:     // Try Bun.file first (for Bun environments)\n104:     if (typeof Bun !== 'undefined' && typeof Bun.file === 'function') {\n105:       try {\n106:         const file = Bun.file(path);\n107:         if (await file.exists()) {\n108:           wasmBytes = await file.arrayBuffer();\n109:         }\n110:       } catch {\n111:         // Bun.file failed, try next method\n112:       }\n113:     }\n114: \n115:     // Try Node.js fs module if Bun.file didn't work\n116:     if (!wasmBytes) {\n117:       try {\n118:         const fs = await import('fs/promises');\n119:         const buffer = await fs.readFile(path);\n120:         wasmBytes = buffer.buffer.slice(buffer.byteOffset, buffer.byteOffset + buffer.byteLength);\n121:       } catch {\n122:         // fs failed, try fetch\n123:       }\n124:     }\n125: \n126:     // Fall back to fetch (for browser environments)\n127:     if (!wasmBytes) {\n128:       const response = await fetch(path);\n129:       if (!response.ok) {\n130:         throw new Error(`Failed to fetch WASM: ${response.status} ${response.statusText}`);\n131:       }\n132:       wasmBytes = await response.arrayBuffer();\n133:       if (wasmBytes.byteLength === 0) {\n134:         throw new Error(`WASM file is empty (0 bytes). Check path: ${path}`);\n135:       }\n136:     }\n137: \n138:     if (!wasmBytes) {\n139:       throw new Error(`Could not load WASM from path: ${path}`);\n140:     }\n141: \n142:     const wasmModule = await WebAssembly.compile(wasmBytes);\n143:     const wasmInstance = await WebAssembly.instantiate(wasmModule, {\n144:       env: {\n145:         log: (ptr: number, len: number) => {\n146:           const bytes = new Uint8Array(\n147:             (wasmInstance.exports as GhosttyWasmExports).memory.buffer,\n148:             ptr,\n149:             len\n150:           );\n151:           console.log('[ghostty-vt]', new TextDecoder().decode(bytes));\n152:         },\n153:       },\n154:     });\n155:     return new Ghostty(wasmInstance);\n156:   }\n157: }\n158: \n159: /**\n160:  * Key Encoder - converts keyboard events into terminal escape sequences\n161:  */\n162: export class KeyEncoder {\n163:   private exports: GhosttyWasmExports;\n165: \n166:   constructor(exports: GhosttyWasmExports) {\n167:     this.exports = exports;\n168:     const encoderPtrPtr = this.exports.ghostty_wasm_alloc_opaque();\n169:     const result = this.exports.ghostty_key_encoder_new(0, encoderPtrPtr);\n170:     if (result !== 0) throw new Error(`Failed to create key encoder: ${result}`);\n171:     const view = new DataView(this.exports.memory.buffer);\n172:     this.encoder = view.getUint32(encoderPtrPtr, true);\n173:     this.exports.ghostty_wasm_free_opaque(encoderPtrPtr);\n174:   }\n175: \n176:   setOption(option: KeyEncoderOption, value: boolean | number): void {\n177:     const valuePtr = this.exports.ghostty_wasm_alloc_u8();\n178:     const view = new DataView(this.exports.memory.buffer);\n179:     view.setUint8(valuePtr, typeof value === 'boolean' ? (value ? 1 : 0) : value);\n180:     this.exports.ghostty_key_encoder_setopt(this.encoder, option, valuePtr);\n181:     this.exports.ghostty_wasm_free_u8(valuePtr);\n182:   }\n183: \n184:   setKittyFlags(flags: KittyKeyFlags): void {\n185:     this.setOption(KeyEncoderOption.KITTY_KEYBOARD_FLAGS, flags);\n186:   }\n187: \n188:   encode(event: KeyEvent): Uint8Array {\n189:     const eventPtrPtr = this.exports.ghostty_wasm_alloc_opaque();\n190:     const createResult = this.exports.ghostty_key_event_new(0, eventPtrPtr);\n191:     if (createResult !== 0) throw new Error(`Failed to create key event: ${createResult}`);\n192: \n193:     const view = new DataView(this.exports.memory.buffer);\n194:     const eventPtr = view.getUint32(eventPtrPtr, true);\n195:     this.exports.ghost