{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c352","stream":{"kind":"session","id":"01a1a0b0-5e8a-72e0-96df-91a8c78d043f"},"sequence":3,"recorded_at":1780531400000002,"record_type":"event","durability":"durable","causation_id":"01a1a0b0-632b-7f63-9fc9-a98be3e15f1b","payload_type":"run.model.configured","payload_schema_version":1,"payload":{"kind":"run_model_configured","command_id":"01a1a0b0-632b-7f63-9fc9-a98be3e15f1b","run_stream":{"kind":"run","id":"01a1a0b0-632b-7f63-9fc9-a98be3e15f1b"},"provider_id":"meta","profile_id":"tbh","model_id":"muse-wonder-1.0","display_label":"muse-wonder-1.0","source":"startup"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c354","stream":{"kind":"session","id":"01a1a0b0-5e8a-72e0-96df-91a8c78d043f"},"sequence":4,"recorded_at":1780531400000004,"record_type":"status","durability":"ephemeral","causation_id":"01a1a0b0-632b-7f63-9fc9-a98be3e15f1b","payload_type":"turn.input.user","payload_schema_version":1,"payload":{"kind":"turn_input_user","command_id":"01a1a0b0-632b-7f63-9fc9-a98be3e15f1b","run_stream":{"kind":"run","id":"01a1a0b0-632b-7f63-9fc9-a98be3e15f1b"},"prompt":"Plan review for AX Code Desktop performance implementation, not a broad WASM rewrite. Respond in English. User authorized plan, implement, test, commit with Grok and Muse. Review supplied complete source only, no tools/writes/delegation. Previous local probes: live 500k many-block first parse ~869ms, append ~2.6ms; open 500k fence append ~42ms. Shiki WASM not consistently faster than JS, so keep JS. User pointed to sibling ax-code-diff: native supports preview/edit/patch, but current untracked private @ax-code/diff-wasm 0.1.0 only exposes duplicate comparison, explicitly not preview/hunks and unpublished. Desktop cannot depend on sibling source/artifacts. No integration of that pilot now.\nProposed scope: optimize existing Markdown Worker without changing ownership, parser semantics or protocol. Investigate avoid redundant marked inline lexing (only top-level type/raw used, remark parses inline again): public Lexer.blockTokens can skip inlineQueue processing but must preserve CRLF normalization and token offsets, reference fallbacks, malformed behavior. Also investigate batching stable small blocks to reduce per-block remark parser overhead vs retaining block-local exact MDAST; may reject if parity risky. Long open code fence faster path must preserve full parser semantics (indentation, tabs, language/meta escaping, CRLF, positions, closing fence changes); prefer no handwritten parser unless well justified. Add workload attribution and reproducible before/after benchmark, golden parity tests and bounded failure tests. Existing Electron renderer-trace uses isolated fixture; fresh WebMCP DOM/screenshots required. Recommend smallest high-value changes, identify pitfalls and meaningful regression tests. Do not invent speedups; explicitly say if an option should be rejected. Return under 1600 words.\n\nFILE desktop/packages/ui/src/components/chat/markdownStreamBlocks.ts\nimport { marked, type Tokens } from \"marked\"\nimport remend from \"remend\"\n\nexport type MarkdownStreamBlock = {\n  key: string\n  raw: string\n  src: string\n  mode: \"full\" | \"live\"\n}\n\n/**\n * Incremental lex cache for a streaming message. `stableBlocks` covers the\n * first `stablePrefixLength` characters of `text`; appended text can only\n * change block structure from the last meaningful token onward, so subsequent\n * ticks re-lex just the tail instead of the whole message.\n */\nexport type LiveMarkdownLexCache = {\n  baseKey: string\n  text: string\n  stablePrefixLength: number\n  stableBlocks: MarkdownStreamBlock[]\n}\n\nconst hasReferenceDefinitions = (text: string): boolean => {\n  // Up to three leading spaces are allowed (CommonMark), the space after the colon is\n  // optional, and the destination may sit on the following (indented) line. Missing a\n  // definition split it into a block of its own, so an earlier `[docs]` link rendered as\n  // literal text until the message finalized.\n  return /^[ \\t]{0,3}\\[[^\\]]+\\]:[ \\t]*(?:\\S|$)/m.test(text)\n}\n\nconst hasOpenFence = (raw: string): boolean => {\n  const match = raw.match(/^[ \\t]{0,3}(`{3,}|~{3,})/)\n  if (!match) return false\n  const marker = match[1]\n  if (!marker) return false\n  const char = marker[0]\n  const size = marker.length\n  const last = raw.trimEnd().split(\"\\n\").at(-1)?.trim() ?? \"\"\n  return !new RegExp(`^[\\\\t ]{0,3}${char}{${size},}[\\\\t ]*$`).test(last)\n}\n\nconst healMarkdown = (text: string): string => {\n  return remend(text, { linkMode: \"text-only\" })\n}\n\nconst fnv1a32 = (input: string): string => {\n  let hash = 0x811c9dc5\n  for (let i = 0; i < input.length; i += 1) {\n    hash ^= input.charCodeAt(i)\n    hash = (hash + ((hash << 1) + (hash << 4) + (hash << 7) + (hash << 8) + (hash << 24))) >>> 0\n  }\n  return hash.toString(16)\n}\n\nconst buildMarkdownCacheKey = (baseKey: string, raw: string, index: number, mode: \"full\" | \"live\"): string => {\n  const sample = raw.length > 400 ? `${raw.slice(0, 200)}${raw.slice(-200)}` : raw\n  return `${baseKey}:${index}:${mode}:${raw.length}:${fnv1a32(sample)}`\n}\n\nexport const buildFullMarkdownBlock = (text: string, baseKey: string): MarkdownStreamBlock => ({\n  key: buildMarkdownCacheKey(baseKey, text, 0, \"full\"),\n  raw: text,\n  src: text,\n  mode: \"full\",\n})\n\nconst buildWholeLiveBlock = (text: string, baseKey: string): MarkdownStreamBlock => ({\n  key: buildMarkdownCacheKey(baseKey, text, 0, \"live\"),\n  raw: text,\n  src: healMarkdown(text),\n  mode: \"live\",\n})\n\nconst emptyCache = (baseKey: string, text: string): LiveMarkdownLexCache => ({\n  baseKey,\n  text,\n  stablePrefixLength: 0,\n  stableBlocks: [],\n})\n\n/**\n * Split streaming markdown into renderable blocks: every block except the last\n * meaningful one is final (\"full\"), the trailing block is \"live\" and re-renders\n * as it grows. When `cache` matches an append-only prefix of `text`, only the\n * tail after the cached stable prefix is re-lexed and re-healed — the output is\n * identical to lexing from scratch, but per-tick cost stays proportional to the\n * tail instead of the whole message.\n */\nexport const buildLiveMarkdownBlocks = (\n  text: string,\n  baseKey: string,\n  cache?: LiveMarkdownLexCache | null,\n): { blocks: MarkdownStreamBlock[]; cache: LiveMarkdownLexCache } => {\n  // Reference definitions can restyle earlier blocks, so fall back to one live\n  // block over the whole text.\n  if (hasReferenceDefinitions(text)) {\n    return { blocks: [buildWholeLiveBlock(text, baseKey)], cache: emptyCache(baseKey, text) }\n  }\n\n  const canReusePrefix =\n    cache != null &&\n    cache.baseKey === baseKey &&\n    cache.stablePrefixLength > 0 &&\n    text.length >= cache.text.length &&\n    text.startsWith(cache.text)\n  const stableBlocks = canReusePrefix ? cache.stableBlocks : []\n  const stablePrefixLength = canReusePrefix ? cache.stablePrefixLength : 0\n\n  let tokens: ReturnType<typeof marked.lexer>\n  try {\n    tokens = marked.lexer(text.slice(stablePrefixLength))\n  } catch {\n    // Pathologically nested or malformed input can overflow the lexer; fall back\n    // to one live block so the text renders instead of crashing the chat.\n    return { blocks: [buildWholeLiveBlock(text, baseKey)], cache: emptyCache(baseKey, text) }\n  }\n\n  let lastMeaningfulIndex = -1\n  for (let index = 0; index < tokens.length; index += 1) {\n    if (tokens[index]?.type !== \"space\") {\n      lastMeaningfulIndex = index\n    }\n  }\n\n  const blocks = stableBlocks.slice()\n  let blockIndex = stableBlocks.length\n  let nextStablePrefixLength = stablePrefixLength\n  for (let index = 0; index < tokens.length; index += 1) {\n    const token = tokens[index] as Tokens.Generic\n    const raw = token.raw ?? \"\"\n    if (token.type !== \"space\") {\n      const mode: \"full\" | \"live\" = index === lastMeaningfulIndex ? \"live\" : \"full\"\n      // A \"full\" block is already complete: healing it rewrote literal text in finished\n      // paragraphs (`array[0` lost its bracket, `**` was appended, image-like text was\n      // deleted). Only the live tail needs healing.\n      const src =\n        mode === \"live\"\n          ? token.type === \"code\" && hasOpenFence(raw)\n            ? raw\n            : healMarkdown(raw)\n          : raw\n      blocks.push({\n        key: buildMarkdownCacheKey(baseKey, raw, blockIndex, mode),\n        raw,\n        src,\n        mode,\n      })\n      blockIndex += 1\n    }\n    if (index < lastMeaningfulIndex) {\n      nextStablePrefixLength += raw.length\n    }\n  }\n\n  if (blocks.length === 0) {\n    return { blocks: [buildWholeLiveBlock(text, baseKey)], cache: emptyCache(baseKey, text) }\n  }\n\n  const lastBlock = blocks[blocks.length - 1]\n  return {\n    blocks,\n    cache: {\n      baseKey,\n      text,\n      stablePrefixLength: nextStablePrefixLength,\n      stableBlocks: lastBlock?.mode === \"live\" ? blocks.slice(0, -1) : blocks,\n    },\n  }\n}\n\nFILE desktop/packages/ui/src/components/chat/markdownWorkerParser.ts\nimport { unified } from \"unified\"\nimport remarkParse from \"remark-parse\"\nimport remarkGfm from \"remark-gfm\"\nimport remarkMath from \"remark-math\"\nimport type { Root } from \"mdast\"\nimport { buildFullMarkdownBlock, buildLiveMarkdownBlocks, type LiveMarkdownLexCache } from \"./markdownStreamBlocks\"\nimport type { MarkdownParseRequest, MarkdownParseResponse, ParsedMarkdownBlock } from \"./markdownWorkerProtocol\"\n\nconst parser = unified().use(remarkParse).use(remarkGfm).use(remarkMath)\n\nconst parseSyntax = (source: string): Root => parser.parse(source) as Root\n\nexport const createMarkdownWorkerParser = (parse = parseSyntax) => {\n  // Retain only the last successful live request. Message changes, rewrites and\n  // finalization invalidate reuse; terminating the worker releases this cache.\n  let previous: { text: string; baseKey: string; lex: LiveMarkdownLexCache; blocks: ParsedMarkdownBlock[] } | null =\n    null\n  return (request: MarkdownParseRequest): ParsedMarkdownBlock[] => {\n    const reusable = request.live && previous?.baseKey === request.baseKey && request.text.startsWith(previous.text)\n    const oldBlocks = reusable ? previous!.blocks : []\n    const projected = request.live\n      ? buildLiveMarkdownBlocks(request.text, request.baseKey, reusable ? previous!.lex : null)\n      : null\n    const blocks = projected?.blocks ?? [buildFullMarkdownBlock(request.text, request.baseKey)]\n    const parsed = blocks.map((block, index) => {\n      const old = oldBlocks[index]\n      if (\n        block.mode === \"full\" &&\n        old?.mode === \"full\" &&\n        block.key === old.key &&\n        block.raw === old.raw &&\n        block.src === old.src\n      )\n        return old\n      // Detach completed substrings from prior request buffers. V8 sliced\n      // strings can otherwise retain many whole streaming snapshots. Copy UTF-16\n      // units directly so unfinished surrogate pairs are preserved as well.\n      const raw = block.mode === \"full\" ? block.raw.split(\"\").join(\"\") : block.raw\n      const src = block.mode === \"full\" ? (block.src === block.raw ? raw : block.src.split(\"\").join(\"\")) : block.src\n      return { ...block, raw, src, tree: parse(src) }\n    })\n    const stable = projected ? parsed.slice(0, projected.cache.stableBlocks.length) : []\n    if (projected) projected.cache.stableBlocks = stable\n    // The live tail is always parsed again; retaining its old AST would only\n    // increase peak memory during the next parse.\n    previous = projected ? { text: request.text, baseKey: request.baseKey, lex: projected.cache, blocks: stable } : null\n    return parsed\n  }\n}\n\n// Stateless entry point for parity checks and standalone parsing.\nexport const parseMarkdownInWorker = (request: MarkdownParseRequest): ParsedMarkdownBlock[] =>\n  createMarkdownWorkerParser()(request)\n\n/** Omit unchanged blocks the receiver explicitly acknowledged; send the changed suffix. */\nexport const createMarkdownWorkerResponder = () => {\n  const parse = createMarkdownWorkerParser()\n  let previous: { request: MarkdownParseRequest; blocks: ParsedMarkdownBlock[] } | null = null\n  return (request: MarkdownParseRequest): MarkdownParseResponse => {\n    const blocks = parse(request)\n    let stablePrefixCount = 0\n    if (\n      request.live &&\n      previous &&\n      request.ownerId !== undefined &&\n      request.ownerId === previous.request.ownerId &&\n      request.baseKey === previous.request.baseKey &&\n      request.baseRevision === previous.request.id\n    ) {\n      // The parser reuses references only for semantically stable blocks. A\n      // reference definition, rewrite, or final parse invalidates that reuse.\n      while (\n        stablePrefixCount < blocks.length &&\n        blocks[stablePrefixCount].mode === \"full\" &&\n        blocks[stablePrefixCount] === previous.blocks[stablePrefixCount]\n      )\n        stablePrefixCount++\n    }\n    const response: MarkdownParseResponse = {\n      id: request.id,\n      blocks: stablePrefixCount ? blocks.slice(stablePrefixCount) : blocks,\n      ...(stablePrefixCount ? { stablePrefixCount, baseRevision: previous!.request.id } : {}),\n    }\n    // One bounded response, shared with the parser, never a transcript cache.\n    previous = request.live ? { request, blocks } : null\n    return response\n  }\n}\n\nFILE desktop/packages/ui/src/components/chat/markdownWorkerProtocol.ts\nimport type { Root } from \"mdast\"\nimport type { MarkdownStreamBlock } from \"./markdownStreamBlocks\"\n\nexport type ParsedMarkdownBlock = MarkdownStreamBlock & { tree?: Root; plain?: boolean }\nexport type MarkdownParseRequest = {\n  id: number\n  text: string\n  live: boolean\n  baseKey: string\n  ownerId?: number\n  baseRevision?: number\n}\nexport type MarkdownParseResponse = {\n  id: number\n  blocks: ParsedMarkdownBlock[] | null\n  baseRevision?: number\n  stablePrefixCount?: number\n}\n\nexport const LARGE_MARKDOWN_THRESHOLD = 16_384\nexport const MAX_WORKER_MARKDOWN_CHARACTERS = 1_000_000\n\nFILE desktop/packages/ui/src/components/chat/markdownWorkerParser.test.ts\nimport { describe, expect, test, vi } from \"vitest\"\nimport {\n  createMarkdownWorkerParser,\n  createMarkdownWorkerResponder,\n  parseMarkdownInWorker,\n} from \"./markdownWorkerParser\"\nimport type { MarkdownParseRequest } from \"./markdownWorkerProtocol\"\n\nconst request = (text: string, overrides: Partial<MarkdownParseRequest> = {}): MarkdownParseRequest => ({\n  id: 1,\n  text,\n  live: true,\n  baseKey: \"test\",\n  ...overrides,\n})\n\ndescribe(\"worker response transfer\", () => {\n  test(\"sends only the changed suffix against an acknowledged live revision\", () => {\n    const respond = createMarkdownWorkerResponder()\n    const first = respond(request(\"# Heading\\n\\nStable **body**\\n\\nTail\", { id: 1, ownerId: 1 }))\n    const input = request(\"# Heading\\n\\nStable **body**\\n\\nTail grows\", { id: 2, ownerId: 1, baseRevision: 1 })\n    const next = respond(input)\n    expect(next.stablePrefixCount).toBe(2)\n    expect(next.blocks).toHaveLength(1)\n    expect([...first.blocks!.slice(0, next.stablePrefixCount), ...next.blocks!]).toEqual(parseMarkdownInWorker(input))\n  })\n\n  test.each([\n    { id: 2, ownerId: 2, baseRevision: 1 },\n    { id: 2, ownerId: 1, baseRevision: 0 },\n    { id: 2, ownerId: 1, baseRevision: 1, live: false },\n  ])(\"sends a full response for owner, revision, and finalization changes\", (overrides) => {\n    const respond = createMarkdownWorkerResponder()\n    const text = \"# Heading\\n\\nStable body\\n\\nTail\"\n    respond(request(text, { id: 1, ownerId: 1 }))\n    const input = request(text + \" grows\", overrides)\n    const next = respond(input)\n    expect(next.stablePrefixCount ?? 0).toBe(0)\n    expect(next.blocks).toEqual(parseMarkdownInWorker(input))\n  })\n\n  test(\"a late reference definition invalidates the completed prefix\", () => {\n    const respond = createMarkdownWorkerResponder()\n    const text = \"# Heading\\n\\n[reference] text\\n\\nTail\\n\\n\"\n    respond(request(text, { id: 1, ownerId: 1 }))\n    const input = request(text + \"[reference]: https://example.com\", { id: 2, ownerId: 1, baseRevision: 1 })\n    const next = respond(input)\n    expect(next.stablePrefixCount ?? 0).toBe(0)\n    expect(next.blocks).toEqual(parseMarkdownInWorker(input))\n  })\n})\n\ndescribe(\"Incremental worker Markdown parsing\", () => {\n  test(\"preserves UTF-16 source and CRLF when retaining completed blocks\", () => {\n    const parse = createMarkdownWorkerParser()\n    const prefix = \"# 中文 😀 \\ud800\\r\\n\\r\\nBody \\udc00\\r\\n\\r\\nTail\"\n    const initial = parse(request(prefix))\n    const input = request(prefix + \" appended\")\n    const next = parse(input)\n    expect(next).toEqual(parseMarkdownInWorker(input))\n    expect(next[0]).toBe(initial[0])\n    expect(next[0].raw).toContain(\"\\ud800\")\n  })\n  test(\"matches stateless parsing while reusing completed ASTs\", () => {\n    const syntax = vi.fn((source: string) => parseMarkdownInWorker(request(source, { live: false }))[0].tree!)\n    const parse = createMarkdownWorkerParser(syntax)\n    const first = parse(request(\"# Header\\n\\n**complete**\\n\\nTail\"))\n    const calls = syntax.mock.calls.length\n    const nextRequest = request(\"# Header\\n\\n**complete**\\n\\nTail grows\")\n    const next = parse(nextRequest)\n    expect(next).toEqual(parseMarkdownInWorker(nextRequest))\n    expect(next[0]).toBe(first[0])\n    expect(next[1]).toBe(first[1])\n    expect(next.at(-1)?.tree).not.toBe(first.at(-1)?.tree)\n    expect(syntax.mock.calls.length - calls).toBe(1)\n  })\n\n  test.each([\n    \"[ref]: ./new.ts\\n\\nTail\",\n    \"[^1]: footnote\\n\\nTail\",\n    \"=====\\n\\nTail\",\n    \"```\\nconst x = 1\\n```\\n\\nTail\",\n    \"| a | b |\\n| - | - |\\n| 1 | 2 |\\n\\nTail\",\n    \"$$\\nx+1\\n$$\\n\\nTail\",\n  ])(\"preserves parsing when appended syntax changes block interpretation: %s\", (suffix) => {\n    const parse = createMarkdownWorkerParser()\n    const prefix = \"Completed **paragraph**\\n\\n[ref] text\\n\\n\"\n    parse(request(prefix))\n    for (let length = 1; length <= suffix.length; length++) {\n      const input = request(prefix + suffix.slice(0, length))\n      expect(parse(input)).toEqual(parseMarkdownInWorker(input))\n    }\n  })\n\n  test(\"invalidates cross-message, rewrite, truncation and finalization reuse\", () => {\n    const parse = createMarkdownWorkerParser()\n    const original = request(\"# One\\n\\nBody\\n\\nTail\")\n    let previous = parse(original)\n    for (const input of [\n      request(original.text + \" grows\", { baseKey: \"other\" }),\n      request(\"# One\\n\\nChanged\\n\\nTail\", { baseKey: \"other\" }),\n      request(\"# One\\n\\nChanged\", { baseKey: \"other\" }),\n      request(\"# One\\n\\nChanged\", { baseKey: \"other\", live: false }),\n      original,\n    ]) {\n      const next = parse(input)\n      expect(next).toEqual(parseMarkdownInWorker(input))\n      expect(next[0].tree).not.toBe(previous[0].tree)\n      previous = next\n    }\n  })\n})\n"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c356","stream":{"kind":"session","id":"01a1a0b0-5e8a-72e0-96df-91a8c78d043f"},"sequence":5,"recorded_at":1780531400000006,"record_type":"event","durability":"durable","causation_id":"01a1a0b0-632b-7f63-9fc9-a98be3e15f1b","payload_type":"run.lifecycle.started","payload_schema_version":1,"payload":{"kind":"run_started","command_id":"01a1a0b0-632b-7f63-9fc9-a98be3e15f1b","run_stream":{"kind":"run","id":"01a1a0b0-632b-7f63-9fc9-a98be3e15f1b"},"prompt":"Plan review for AX Code Desktop performance implementation, not a broad WASM rewrite. Respond in English. User authorized plan, implement, test, commit with Grok and Muse. Review supplied complete source only, no tools/writes/delegation. Previous local probes: live 500k many-block first parse ~869ms, append ~2.6ms; open 500k fence append ~42ms. Shiki WASM not consistently faster than JS, so keep JS. User pointed to sibling ax-code-diff: native supports preview/edit/patch, but current untracked private @ax-code/diff-wasm 0.1.0 only exposes duplicate comparison, explicitly not preview/hunks and unpublished. Desktop cannot depend on sibling source/artifacts. No integration of that pilot now.\nProposed scope: optimize existing Markdown Worker without changing ownership, parser semantics or protocol. Investigate avoid redundant marked inline lexing (only top-level type/raw used, remark parses inline again): public Lexer.blockTokens can skip inlineQueue processing but must preserve CRLF normalization and token offsets, reference fallbacks, malformed behavior. Also investigate batching stable small blocks to reduce per-block remark parser overhead vs retaining block-local exact MDAST; may reject if parity risky. Long open code fence faster path must preserve full parser semantics (indentation, tabs, language/meta escaping, CRLF, positions, closing fence changes); prefer no handwritten parser unless well justified. Add workload attribution and reproducible before/after benchmark, golden parity tests and bounded failure tests. Existing Electron renderer-trace uses isolated fixture; fresh WebMCP DOM/screenshots required. Recommend smallest high-value changes, identify pitfalls and meaningful regression tests. Do not invent speedups; explicitly say if an option should be rejected. Return under 1600 words.\n\nFILE desktop/packages/ui/src/components/chat/markdownStreamBlocks.ts\nimport { marked, type Tokens } from \"marked\"\nimport remend from \"remend\"\n\nexport type MarkdownStreamBlock = {\n  key: string\n  raw: string\n  src: string\n  mode: \"full\" | \"live\"\n}\n\n/**\n * Incremental lex cache for a streaming message. `stableBlocks` covers the\n * first `stablePrefixLength` characters of `text`; appended text can only\n * change block structure from the last meaningful token onward, so subsequent\n * ticks re-lex just the tail instead of the whole message.\n */\nexport type LiveMarkdownLexCache = {\n  baseKey: string\n  text: string\n  stablePrefixLength: number\n  stableBlocks: MarkdownStreamBlock[]\n}\n\nconst hasReferenceDefinitions = (text: string): boolean => {\n  // Up to three leading spaces are allowed (CommonMark), the space after the colon is\n  // optional, and the destination may sit on the following (indented) line. Missing a\n  // definition split it into a block of its own, so an earlier `[docs]` link rendered as\n  // literal text until the message finalized.\n  return /^[ \\t]{0,3}\\[[^\\]]+\\]:[ \\t]*(?:\\S|$)/m.test(text)\n}\n\nconst hasOpenFence = (raw: string): boolean => {\n  const match = raw.match(/^[ \\t]{0,3}(`{3,}|~{3,})/)\n  if (!match) return false\n  const marker = match[1]\n  if (!marker) return false\n  const char = marker[0]\n  const size = marker.length\n  const last = raw.trimEnd().split(\"\\n\").at(-1)?.trim() ?? \"\"\n  return !new RegExp(`^[\\\\t ]{0,3}${char}{${size},}[\\\\t ]*$`).test(last)\n}\n\nconst healMarkdown = (text: string): string => {\n  return remend(text, { linkMode: \"text-only\" })\n}\n\nconst fnv1a32 = (input: string): string => {\n  let hash = 0x811c9dc5\n  for (let i = 0; i < input.length; i += 1) {\n    hash ^= input.charCodeAt(i)\n    hash = (hash + ((hash << 1) + (hash << 4) + (hash << 7) + (hash << 8) + (hash << 24))) >>> 0\n  }\n  return hash.toString(16)\n}\n\nconst buildMarkdownCacheKey = (baseKey: string, raw: string, index: number, mode: \"full\" | \"live\"): string => {\n  const sample = raw.length > 400 ? `${raw.slice(0, 200)}${raw.slice(-200)}` : raw\n  return `${baseKey}:${index}:${mode}:${raw.length}:${fnv1a32(sample)}`\n}\n\nexport const buildFullMarkdownBlock = (text: string, baseKey: string): MarkdownStreamBlock => ({\n  key: buildMarkdownCacheKey(baseKey, text, 0, \"full\"),\n  raw: text,\n  src: text,\n  mode: \"full\",\n})\n\nconst buildWholeLiveBlock = (text: string, baseKey: string): MarkdownStreamBlock => ({\n  key: buildMarkdownCacheKey(baseKey, text, 0, \"live\"),\n  raw: text,\n  src: healMarkdown(text),\n  mode: \"live\",\n})\n\nconst emptyCache = (baseKey: string, text: string): LiveMarkdownLexCache => ({\n  baseKey,\n  text,\n  stablePrefixLength: 0,\n  stableBlocks: [],\n})\n\n/**\n * Split streaming markdown into renderable blocks: every block except the last\n * meaningful one is final (\"full\"), the trailing block is \"live\" and re-renders\n * as it grows. When `cache` matches an append-only prefix of `text`, only the\n * tail after the cached stable prefix is re-lexed and re-healed — the output is\n * identical to lexing from scratch, but per-tick cost stays proportional to the\n * tail instead of the whole message.\n */\nexport const buildLiveMarkdownBlocks = (\n  text: string,\n  baseKey: string,\n  cache?: LiveMarkdownLexCache | null,\n): { blocks: MarkdownStreamBlock[]; cache: LiveMarkdownLexCache } => {\n  // Reference definitions can restyle earlier blocks, so fall back to one live\n  // block over the whole text.\n  if (hasReferenceDefinitions(text)) {\n    return { blocks: [buildWholeLiveBlock(text, baseKey)], cache: emptyCache(baseKey, text) }\n  }\n\n  const canReusePrefix =\n    cache != null &&\n    cache.baseKey === baseKey &&\n    cache.stablePrefixLength > 0 &&\n    text.length >= cache.text.length &&\n    text.startsWith(cache.text)\n  const stableBlocks = canReusePrefix ? cache.stableBlocks : []\n  const stablePrefixLength = canReusePrefix ? cache.stablePrefixLength : 0\n\n  let tokens: ReturnType<typeof marked.lexer>\n  try {\n    tokens = marked.lexer(text.slice(stablePrefixLength))\n  } catch {\n    // Pathologically nested or malformed input can overflow the lexer; fall back\n    // to one live block so the text renders instead of crashing the chat.\n    return { blocks: [buildWholeLiveBlock(text, baseKey)], cache: emptyCache(baseKey, text) }\n  }\n\n  let lastMeaningfulIndex = -1\n  for (let index = 0; index < tokens.length; index += 1) {\n    if (tokens[index]?.type !== \"space\") {\n      lastMeaningfulIndex = index\n    }\n  }\n\n  const blocks = stableBlocks.slice()\n  let blockIndex = stableBlocks.length\n  let nextStablePrefixLength = stablePrefixLength\n  for (let index = 0; index < tokens.length; index += 1) {\n    const token = tokens[index] as Tokens.Generic\n    const raw = token.raw ?? \"\"\n    if (token.type !== \"space\") {\n      const mode: \"full\" | \"live\" = index === lastMeaningfulIndex ? \"live\" : \"full\"\n      // A \"full\" block is already complete: healing it rewrote literal text in finished\n      // paragraphs (`array[0` lost its bracket, `**` was appended, image-like text was\n      // deleted). Only the live tail needs healing.\n      const src =\n        mode === \"live\"\n          ? token.type === \"code\" && hasOpenFence(raw)\n            ? raw\n            : healMarkdown(raw)\n          : raw\n      blocks.push({\n        key: buildMarkdownCacheKey(baseKey, raw, blockIndex, mode),\n        raw,\n        src,\n        mode,\n      })\n      blockIndex += 1\n    }\n    if (index < lastMeaningfulIndex) {\n      nextStablePrefixLength += raw.length\n    }\n  }\n\n  if (blocks.length === 0) {\n    return { blocks: [buildWholeLiveBlock(text, baseKey)], cache: emptyCache(baseKey, text) }\n  }\n\n  const lastBlock = blocks[blocks.length - 1]\n  return {\n    blocks,\n    cache: {\n      baseKey,\n      text,\n      stablePrefixLength: nextStablePrefixLength,\n      stableBlocks: lastBlock?.mode === \"live\" ? blocks.slice(0, -1) : blocks,\n    },\n  }\n}\n\nFILE desktop/packages/ui/src/components/chat/markdownWorkerParser.ts\nimport { unified } from \"unified\"\nimport remarkParse from \"remark-parse\"\nimport remarkGfm from \"remark-gfm\"\nimport remarkMath from \"remark-math\"\nimport type { Root } from \"mdast\"\nimport { buildFullMarkdownBlock, buildLiveMarkdownBlocks, type LiveMarkdownLexCache } from \"./markdownStreamBlocks\"\nimport type { MarkdownParseRequest, MarkdownParseResponse, ParsedMarkdownBlock } from \"./markdownWorkerProtocol\"\n\nconst parser = unified().use(remarkParse).use(remarkGfm).use(remarkMath)\n\nconst parseSyntax = (source: string): Root => parser.parse(source) as Root\n\nexport const createMarkdownWorkerParser = (parse = parseSyntax) => {\n  // Retain only the last successful live request. Message changes, rewrites and\n  // finalization invalidate reuse; terminating the worker releases this cache.\n  let previous: { text: string; baseKey: string; lex: LiveMarkdownLexCache; blocks: ParsedMarkdownBlock[] } | null =\n    null\n  return (request: MarkdownParseRequest): ParsedMarkdownBlock[] => {\n    const reusable = request.live && previous?.baseKey === request.baseKey && request.text.startsWith(previous.text)\n    const oldBlocks = reusable ? previous!.blocks : []\n    const projected = request.live\n      ? buildLiveMarkdownBlocks(request.text, request.baseKey, reusable ? previous!.lex : null)\n      : null\n    const blocks = projected?.blocks ?? [buildFullMarkdownBlock(request.text, request.baseKey)]\n    const parsed = blocks.map((block, index) => {\n      const old = oldBlocks[index]\n      if (\n        block.mode === \"full\" &&\n        old?.mode === \"full\" &&\n        block.key === old.key &&\n        block.raw === old.raw &&\n        block.src === old.src\n      )\n        return old\n      // Detach completed substrings from prior request buffers. V8 sliced\n      // strings can otherwise retain many whole streaming snapshots. Copy UTF-16\n      // units directly so unfinished surrogate pairs are preserved as well.\n      const raw = block.mode === \"full\" ? block.raw.split(\"\").join(\"\") : block.raw\n      const src = block.mode === \"full\" ? (block.src === block.raw ? raw : block.src.split(\"\").join(\"\")) : block.src\n      return { ...block, raw, src, tree: parse(src) }\n    })\n    const stable = projected ? parsed.slice(0, projected.cache.stableBlocks.length) : []\n    if (projected) projected.cache.stableBlocks = stable\n    // The live tail is always parsed again; retaining its old AST would only\n    // increase peak memory during the next parse.\n    previous = projected ? { text: request.text, baseKey: request.baseKey, lex: projected.cache, blocks: stable } : null\n    return parsed\n  }\n}\n\n// Stateless entry point for parity checks and standalone parsing.\nexport const parseMarkdownInWorker = (request: MarkdownParseRequest): ParsedMarkdownBlock[] =>\n  createMarkdownWorkerParser()(request)\n\n/** Omit unchanged blocks the receiver explicitly acknowledged; send the changed suffix. */\nexport const createMarkdownWorkerResponder = () => {\n  const parse = createMarkdownWorkerParser()\n  let previous: { request: MarkdownParseRequest; blocks: ParsedMarkdownBlock[] } | null = null\n  return (request: MarkdownParseRequest): MarkdownParseResponse => {\n    const blocks = parse(request)\n    let stablePrefixCount = 0\n    if (\n      request.live &&\n      previous &&\n      request.ownerId !== undefined &&\n      request.ownerId === previous.request.ownerId &&\n      request.baseKey === previous.request.baseKey &&\n      request.baseRevision === previous.request.id\n    ) {\n      // The parser reuses references only for semantically stable blocks. A\n      // reference definition, rewrite, or final parse invalidates that reuse.\n      while (\n        stablePrefixCount < blocks.length &&\n        blocks[stablePrefixCount].mode === \"full\" &&\n        blocks[stablePrefixCount] === previous.blocks[stablePrefixCount]\n      )\n        stablePrefixCount++\n    }\n    const response: MarkdownParseResponse = {\n      id: request.id,\n      blocks: stablePrefixCount ? blocks.slice(stablePrefixCount) : blocks,\n      ...(stablePrefixCount ? { stablePrefixCount, baseRevision: previous!.request.id } : {}),\n    }\n    // One bounded response, shared with the parser, never a transcript cache.\n    previous = request.live ? { request, blocks } : null\n    return response\n  }\n}\n\nFILE desktop/packages/ui/src/components/chat/markdownWorkerProtocol.ts\nimport type { Root } from \"mdast\"\nimport type { MarkdownStreamBlock } from \"./markdownStreamBlocks\"\n\nexport type ParsedMarkdownBlock = MarkdownStreamBlock & { tree?: Root; plain?: boolean }\nexport type MarkdownParseRequest = {\n  id: number\n  text: string\n  live: boolean\n  baseKey: string\n  ownerId?: number\n  baseRevision?: number\n}\nexport type MarkdownParseResponse = {\n  id: number\n  blocks: ParsedMarkdownBlock[] | null\n  baseRevision?: number\n  stablePrefixCount?: number\n}\n\nexport const LARGE_MARKDOWN_THRESHOLD = 16_384\nexport const MAX_WORKER_MARKDOWN_CHARACTERS = 1_000_000\n\nFILE desktop/packages/ui/src/components/chat/markdownWorkerParser.test.ts\nimport { describe, expect, test, vi } from \"vitest\"\nimport {\n  createMarkdownWorkerParser,\n  createMarkdownWorkerResponder,\n  parseMarkdownInWorker,\n} from \"./markdownWorkerParser\"\nimport type { MarkdownParseRequest } from \"./markdownWorkerProtocol\"\n\nconst request = (text: string, overrides: Partial<MarkdownParseRequest> = {}): MarkdownParseRequest => ({\n  id: 1,\n  text,\n  live: true,\n  baseKey: \"test\",\n  ...overrides,\n})\n\ndescribe(\"worker response transfer\", () => {\n  test(\"sends only the changed suffix against an acknowledged live revision\", () => {\n    const respond = createMarkdownWorkerResponder()\n    const first = respond(request(\"# Heading\\n\\nStable **body**\\n\\nTail\", { id: 1, ownerId: 1 }))\n    const input = request(\"# Heading\\n\\nStable **body**\\n\\nTail grows\", { id: 2, ownerId: 1, baseRevision: 1 })\n    const next = respond(input)\n    expect(next.stablePrefixCount).toBe(2)\n    expect(next.blocks).toHaveLength(1)\n    expect([...first.blocks!.slice(0, next.stablePrefixCount), ...next.blocks!]).toEqual(parseMarkdownInWorker(input))\n  })\n\n  test.each([\n    { id: 2, ownerId: 2, baseRevision: 1 },\n    { id: 2, ownerId: 1, baseRevision: 0 },\n    { id: 2, ownerId: 1, baseRevision: 1, live: false },\n  ])(\"sends a full response for owner, revision, and finalization changes\", (overrides) => {\n    const respond = createMarkdownWorkerResponder()\n    const text = \"# Heading\\n\\nStable body\\n\\nTail\"\n    respond(request(text, { id: 1, ownerId: 1 }))\n    const input = request(text + \" grows\", overrides)\n    const next = respond(input)\n    expect(next.stablePrefixCount ?? 0).toBe(0)\n    expect(next.blocks).toEqual(parseMarkdownInWorker(input))\n  })\n\n  test(\"a late reference definition invalidates the completed prefix\", () => {\n    const respond = createMarkdownWorkerResponder()\n    const text = \"# Heading\\n\\n[reference] text\\n\\nTail\\n\\n\"\n    respond(request(text, { id: 1, ownerId: 1 }))\n    const input = request(text + \"[reference]: https://example.com\", { id: 2, ownerId: 1, baseRevision: 1 })\n    const next = respond(input)\n    expect(next.stablePrefixCount ?? 0).toBe(0)\n    expect(next.blocks).toEqual(parseMarkdownInWorker(input))\n  })\n})\n\ndescribe(\"Incremental worker Markdown parsing\", () => {\n  test(\"preserves UTF-16 source and CRLF when retaining completed blocks\", () => {\n    const parse = createMarkdownWorkerParser()\n    const prefix = \"# 中文 😀 \\ud800\\r\\n\\r\\nBody \\udc00\\r\\n\\r\\nTail\"\n    const initial = parse(request(prefix))\n    const input = request(prefix + \" appended\")\n    const next = parse(input)\n    expect(next).toEqual(parseMarkdownInWorker(input))\n    expect(next[0]).toBe(initial[0])\n    expect(next[0].raw).toContain(\"\\ud800\")\n  })\n  test(\"matches stateless parsing while reusing completed ASTs\", () => {\n    const syntax = vi.fn((source: string) => parseMarkdownInWorker(request(source, { live: false }))[0].tree!)\n    const parse = createMarkdownWorkerParser(syntax)\n    const first = parse(request(\"# Header\\n\\n**complete**\\n\\nTail\"))\n    const calls = syntax.mock.calls.length\n    const nextRequest = request(\"# Header\\n\\n**complete**\\n\\nTail grows\")\n    const next = parse(nextRequest)\n    expect(next).toEqual(parseMarkdownInWorker(nextRequest))\n    expect(next[0]).toBe(first[0])\n    expect(next[1]).toBe(first[1])\n    expect(next.at(-1)?.tree).not.toBe(first.at(-1)?.tree)\n    expect(syntax.mock.calls.length - calls).toBe(1)\n  })\n\n  test.each([\n    \"[ref]: ./new.ts\\n\\nTail\",\n    \"[^1]: footnote\\n\\nTail\",\n    \"=====\\n\\nTail\",\n    \"```\\nconst x = 1\\n```\\n\\nTail\",\n    \"| a | b |\\n| - | - |\\n| 1 | 2 |\\n\\nTail\",\n    \"$$\\nx+1\\n$$\\n\\nTail\",\n  ])(\"preserves parsing when appended syntax changes block interpretation: %s\", (suffix) => {\n    const parse = createMarkdownWorkerParser()\n    const prefix = \"Completed **paragraph**\\n\\n[ref] text\\n\\n\"\n    parse(request(prefix))\n    for (let length = 1; length <= suffix.length; length++) {\n      const input = request(prefix + suffix.slice(0, length))\n      expect(parse(input)).toEqual(parseMarkdownInWorker(input))\n    }\n  })\n\n  test(\"invalidates cross-message, rewrite, truncation and finalization reuse\", () => {\n    const parse = createMarkdownWorkerParser()\n    const original = request(\"# One\\n\\nBody\\n\\nTail\")\n    let previous = parse(original)\n    for (const input of [\n      request(original.text + \" grows\", { baseKey: \"other\" }),\n      request(\"# One\\n\\nChanged\\n\\nTail\", { baseKey: \"other\" }),\n      request(\"# One\\n\\nChanged\", { baseKey: \"other\" }),\n      request(\"# One\\n\\nChanged\", { baseKey: \"other\", live: false }),\n      original,\n    ]) {\n      const next = parse(input)\n      expect(next).toEqual(parseMarkdownInWorker(input))\n      expect(next[0].tree).not.toBe(previous[0].tree)\n      previous = next\n    }\n  })\n})\n"}}
