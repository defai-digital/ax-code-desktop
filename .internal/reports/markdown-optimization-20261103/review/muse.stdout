{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c354","stream":{"kind":"session","id":"01a1a0b7-0bf0-7f20-bcaf-0661f6003fed"},"sequence":4,"recorded_at":1780531400000004,"record_type":"status","durability":"ephemeral","causation_id":"01a1a0b7-123e-7703-a22d-f7a8f557459a","payload_type":"turn.input.user","payload_schema_version":1,"payload":{"kind":"turn_input_user","command_id":"01a1a0b7-123e-7703-a22d-f7a8f557459a","run_stream":{"kind":"run","id":"01a1a0b7-123e-7703-a22d-f7a8f557459a"},"prompt":"Review this AX Code Desktop implementation plan and patch. English response, no tools, no edits. We are acting on a WASM assessment: no WASM migration passed qualification; keep Shiki JS. User pointed out sibling ax-code-diff; its unpublished private Wasm pilot only supports duplicate comparison, not diff preview/hunks, so no sibling import/integration. Smallest deliverable: remove redundant marked inline tokenization, repair CRLF incremental cache coordinate mismatch, avoid splitting all code lines to inspect last fence line. Tests demonstrated 3 pre-fix failures and 59 focused tests now pass. Read patch carefully for regressions, lifetime/state issues, malformed input and semantic parity. The only consumers of lexer tokens use type/raw; remark handles inline syntax later. marked 17's public Lexer.blockTokens skips draining its inline queue; Lexer.lex first normalizes CRLF/CR to LF. Each lexer is fresh. Reference definitions and lexer failures retain original whole-text fallback. Cache now stores normalized text and lengths together. Propose any required fix, or state no concrete defect. Do not assume speedup; whole parser still dominated by remark. Keep answer under 900 words.\ndiff --git a/desktop/packages/ui/src/components/chat/markdownStreamBlocks.test.ts b/desktop/packages/ui/src/components/chat/markdownStreamBlocks.test.ts\nindex 2f01838e..e3da278d 100644\n--- a/desktop/packages/ui/src/components/chat/markdownStreamBlocks.test.ts\n+++ b/desktop/packages/ui/src/components/chat/markdownStreamBlocks.test.ts\n@@ -1,4 +1,5 @@\n-import { describe, expect, test } from \"vitest\"\n+import { marked } from \"marked\"\n+import { describe, expect, test, vi } from \"vitest\"\n \n import { buildLiveMarkdownBlocks, type LiveMarkdownLexCache } from \"./markdownStreamBlocks\"\n \n@@ -68,6 +69,37 @@ Paragraph after math with trailing text that streams to the very end.\n `\n \n describe(\"buildLiveMarkdownBlocks\", () => {\n+  test.each([\"\\r\\n\", \"\\r\"])(\"keeps normalized cache offsets aligned for %j line endings\", (newline) => {\n+    const prefix = `# Heading${newline}${newline}Paragraph${newline}${newline}`.repeat(10) + \"Tail\"\n+    const first = buildLiveMarkdownBlocks(prefix, BASE_KEY)\n+    const next = buildLiveMarkdownBlocks(prefix + \" grows\", BASE_KEY, first.cache)\n+    expect(next.blocks).toEqual(fromScratch(prefix + \" grows\"))\n+    expect(next.blocks[0]).toBe(first.blocks[0])\n+  })\n+\n+  test(\"does not parse inline tokens that the Markdown renderer will parse again\", () => {\n+    const inline = vi.spyOn(marked.Lexer.prototype, \"inlineTokens\")\n+    try {\n+      const text = \"# **Heading**\\n\\nText with [a link](https://example.com) and `code`.\\n\\nTail\"\n+      const { blocks } = buildLiveMarkdownBlocks(text, BASE_KEY)\n+      expect(blocks).toHaveLength(3)\n+      expect(blocks[1].raw).toContain(\"[a link](https://example.com)\")\n+      expect(inline).not.toHaveBeenCalled()\n+    } finally {\n+      inline.mockRestore()\n+    }\n+  })\n+\n+  test.each([\"\\n\", \"\\r\\n\", \"\\r\"])(\"preserves marked block boundaries with %j line endings\", (newline) => {\n+    const text = DOCUMENT.replaceAll(\"\\n\", newline)\n+    const expected = marked.lexer(text).filter((token) => token.type !== \"space\").map((token) => token.raw)\n+    expect(fromScratch(text).map((block) => block.raw)).toEqual(expected)\n+  })\n+\n+  test(\"handles a CRLF pair split across streaming updates\", () => {\n+    expectIncrementalMatchesScratch(DOCUMENT.replaceAll(\"\\n\", \"\\r\\n\"), [1, 7, 23])\n+  })\n+\n   test(\"incremental lexing matches from-scratch lexing at every append step\", () => {\n     for (const chunkSizes of [[1], [3], [7, 2, 11], [64], [1, 40]]) {\n       expectIncrementalMatchesScratch(DOCUMENT, chunkSizes)\ndiff --git a/desktop/packages/ui/src/components/chat/markdownStreamBlocks.ts b/desktop/packages/ui/src/components/chat/markdownStreamBlocks.ts\nindex eae1649c..45ed4cd6 100644\n--- a/desktop/packages/ui/src/components/chat/markdownStreamBlocks.ts\n+++ b/desktop/packages/ui/src/components/chat/markdownStreamBlocks.ts\n@@ -1,4 +1,4 @@\n-import { marked, type Tokens } from \"marked\"\n+import { marked, type Token } from \"marked\"\n import remend from \"remend\"\n \n export type MarkdownStreamBlock = {\n@@ -10,7 +10,7 @@ export type MarkdownStreamBlock = {\n \n /**\n  * Incremental lex cache for a streaming message. `stableBlocks` covers the\n- * first `stablePrefixLength` characters of `text`; appended text can only\n+ * first `stablePrefixLength` characters of the LF-normalized `text`; appended text can only\n  * change block structure from the last meaningful token onward, so subsequent\n  * ticks re-lex just the tail instead of the whole message.\n  */\n@@ -36,7 +36,8 @@ const hasOpenFence = (raw: string): boolean => {\n   if (!marker) return false\n   const char = marker[0]\n   const size = marker.length\n-  const last = raw.trimEnd().split(\"\\n\").at(-1)?.trim() ?? \"\"\n+  const trimmed = raw.trimEnd()\n+  const last = trimmed.slice(trimmed.lastIndexOf(\"\\n\") + 1).trim()\n   return !new RegExp(`^[\\\\t ]{0,3}${char}{${size},}[\\\\t ]*$`).test(last)\n }\n \n@@ -98,18 +99,24 @@ export const buildLiveMarkdownBlocks = (\n     return { blocks: [buildWholeLiveBlock(text, baseKey)], cache: emptyCache(baseKey, text) }\n   }\n \n+  // marked normalizes CRLF/CR before lexing. Cache and slice in that same\n+  // coordinate space or a long CRLF prefix can repeat completed blocks.\n+  const normalizedText = text.replace(/\\r\\n?/g, \"\\n\")\n+\n   const canReusePrefix =\n     cache != null &&\n     cache.baseKey === baseKey &&\n     cache.stablePrefixLength > 0 &&\n-    text.length >= cache.text.length &&\n-    text.startsWith(cache.text)\n+    normalizedText.length >= cache.text.length &&\n+    normalizedText.startsWith(cache.text)\n   const stableBlocks = canReusePrefix ? cache.stableBlocks : []\n   const stablePrefixLength = canReusePrefix ? cache.stablePrefixLength : 0\n \n-  let tokens: ReturnType<typeof marked.lexer>\n+  let tokens: Token[]\n   try {\n-    tokens = marked.lexer(text.slice(stablePrefixLength))\n+    // Only block type/raw are consumed here; remark parses inline syntax later.\n+    // A fresh lexer keeps its undrained inline queue local to this call.\n+    tokens = new marked.Lexer().blockTokens(normalizedText.slice(stablePrefixLength))\n   } catch {\n     // Pathologically nested or malformed input can overflow the lexer; fall back\n     // to one live block so the text renders instead of crashing the chat.\n@@ -127,7 +134,7 @@ export const buildLiveMarkdownBlocks = (\n   let blockIndex = stableBlocks.length\n   let nextStablePrefixLength = stablePrefixLength\n   for (let index = 0; index < tokens.length; index += 1) {\n-    const token = tokens[index] as Tokens.Generic\n+    const token = tokens[index]\n     const raw = token.raw ?? \"\"\n     if (token.type !== \"space\") {\n       const mode: \"full\" | \"live\" = index === lastMeaningfulIndex ? \"live\" : \"full\"\n@@ -162,7 +169,7 @@ export const buildLiveMarkdownBlocks = (\n     blocks,\n     cache: {\n       baseKey,\n-      text,\n+      text: normalizedText,\n       stablePrefixLength: nextStablePrefixLength,\n       stableBlocks: lastBlock?.mode === \"live\" ? blocks.slice(0, -1) : blocks,\n     },\n"}}
