{
  "name": "@ax-code/diff-wasm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Worker-hosted Wasm diff, structured hunks and duplicate comparison using shared Rust kernels",
  "exports": {
    ".": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "wasm",
    "NOTICE"
  ],
  "dependencies": {
    "@ax-code/util": "1.3.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.12",
    "tsx": "4.23.15",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "@ax-code/diff": "0.1.0",
    "@ax-code/ax-code-reason": "0.1.0"
  },
  "scripts": {
    "build": "node script/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node script/browser-smoke.mjs",
    "benchmark": "node --import tsx script/benchmark.mjs"
  }
}
