ersal speed claim. Do not treat requiring publication as permission to publish. Distinguish adapter coordinate conversion from copying a diff kernel. Is this qualification sufficient to justify next consumer prototype, and what would still block production?\n\nRESULTS\n{\n  \"node\": \"v26.5.0\",\n  \"engineSha256\": \"1be901a877c03d4aee2e9da9c79aa0f71c58d4dae8a2a4a7c2ae8e2d8b60178f\",\n  \"fixtures\": 215,\n  \"successful\": 215,\n  \"fullForwardRoundTrips\": 215,\n  \"rendererSubsetRevertCases\": 411,\n  \"identicalSpans\": 215,\n  \"identicalFullMetadata\": 215,\n  \"identicalRevertsWhenSpansMatch\": 215,\n  \"strictStaleContextRejected\": true,\n  \"preAbortedRequestRejectedAndNextCallWorked\": true,\n  \"failures\": []\n}\nBENCHMARK\n{\n  \"node\": \"v26.5.0\",\n  \"cpu\": \"Apple M3 Max\",\n  \"load\": [\n    14.72021484375,\n    45.51123046875,\n    43.56396484375\n  ],\n  \"firstCallMs\": 30.467166000000006,\n  \"notes\": \"Seven alternating warm samples; canonical includes Worker transfer and synchronous Pierre metadata projection. Excludes UI rendering, scheduling, cache hits and browser startup. No p95 or app-wide speed claim.\",\n  \"results\": [\n    {\n      \"lines\": 1000,\n      \"stride\": 995,\n      \"beforeCharacters\": 30890,\n      \"hunks\": 2,\n      \"medianMs\": {\n        \"pierre\": 0.7604160000000064,\n        \"wasmAndMetadata\": 0.9076670000000036\n      }\n    },\n    {\n      \"lines\": 1000,\n      \"stride\": 50,\n      \"beforeCharacters\": 30890,\n      \"hunks\": 20,\n      \"medianMs\": {\n        \"pierre\": 1.0166669999999982,\n        \"wasmAndMetadata\": 1.1185839999999985\n      }\n    },\n    {\n      \"lines\": 10000,\n      \"stride\": 9995,\n      \"beforeCharacters\": 318890,\n      \"hunks\": 2,\n      \"medianMs\": {\n        \"pierre\": 6.5492089999999905,\n        \"wasmAndMetadata\": 6.256124999999997\n      }\n    },\n    {\n      \"lines\": 10000,\n      \"stride\": 50,\n      \"beforeCharacters\": 318890,\n      \"hunks\": 200,\n      \"medianMs\": {\n        \"pierre\": 16.584291000000007,\n        \"wasmAndMetadata\": 10.173040999999955\n      }\n    },\n    {\n      \"lines\": 50000,\n      \"stride\": 49995,\n      \"beforeCharacters\": 1638890,\n      \"hunks\": 2,\n      \"medianMs\": {\n        \"pierre\": 36.830916,\n        \"wasmAndMetadata\": 32.50145900000007\n      }\n    },\n    {\n      \"lines\": 50000,\n      \"stride\": 50,\n      \"beforeCharacters\": 1638890,\n      \"rejected\": \"Error: Diff resource limit exceeded; split the edit into smaller changes\",\n      \"workerRecoveredAfterLimit\": true\n    }\n  ]\n}\nFILE probe.mjs\n// Read-only qualification against an explicitly supplied canonical build.\n// This is not a Desktop runtime dependency or a replacement diff kernel.\nimport assert from \"node:assert/strict\"\nimport { createHash } from \"node:crypto\"\nimport { readFile } from \"node:fs/promises\"\nimport { resolve } from \"node:path\"\nimport { pathToFileURL } from \"node:url\"\nimport { isDeepStrictEqual } from \"node:util\"\n\nconst enginePath = process.argv[2]\nif (!enginePath) throw new Error(\"Usage: node probe.mjs <canonical-dist/node.js>\")\nconst pierrePackage = new URL(\"../../../desktop/packages/ui/node_modules/@pierre/diffs/package.json\", import.meta.url)\nconst pierreManifest = JSON.parse(await readFile(pierrePackage, \"utf8\"))\nconst { parseDiffFromFile, processFile, diffAcceptRejectHunk } = await import(new URL(pierreManifest.exports[\".\"].import, pierrePackage).href)\nconst { createDiffEngine } = await import(pathToFileURL(resolve(enginePath)).href)\nconst fixtures = []\nconst atoms = [\"\", \"a\", \"a\\n\", \"a\\r\\n\", \"\\n\", \"\\r\", \"中文😀\\r\\nb\", \"a\\nb\\nc\\n\", \"\\0\"]\nfor (const [left, before] of atoms.entries()) {\n  for (const [right, after] of atoms.entries()) fixtures.push({ name: `edge-${left}-${right}`, before, after })\n}\nfor (const newline of [\"\\n\", \"\\r\\n\"]) {\n  for (const gap of [1, 4, 7, 8, 9, 12, 30]) {\n    const lines = Array.from({ length: 64 }, (_, index) => `line ${index}${newline}`)\n    const after = [...lines]\n    after[5] = `first edit${newline}`\n    after[6 + gap] = `second edit${newline}`\n    fixtures.push({ name: `gap-${JSON.stringify(newline)}-${gap}`, before: lines.join(\"\"), after: after.join(\"\") })\n  }\n}\nlet seed = 0xabc123\nconst random = (limit) => {\n  seed ^= seed << 13\n  seed ^= seed >>> 17\n  seed ^= seed << 5\n  return (seed >>> 0) % limit\n}\nfor (let index = 0; index < 120; index++) {\n  const newline = index % 2 ? \"\\r\\n\" : \"\\n\"\n  const lines = Array.from({ length: 40 + random(100) }, () => `repeat ${random(12)} 中文😀${newline}`)\n  const after = [...lines]\n  for (let change = 0; change < 4; change++) {\n    after.splice(random(after.length), random(3), ...Array.from({ length: random(4) }, () => `changed ${random(10)}${newline}`))\n  }\n  fixtures.push({ name: `seeded-${index}`, before: lines.join(\"\"), after: after.join(\"\") })\n}\n\n// Adapt only the documented unified header convention: canonical empty ranges\n// are one-based; unified patch headers name the line before an empty range.\nfunction patchText(preview) {\n  const range = (start, count) => `${count === 0 ? start - 1 : start},${count}`\n  return \"--- fixture.txt\\n+++ fixture.txt\\n\" + preview.hunks.map((hunk) =>\n    `@@ -${range(hunk.oldStart, hunk.oldLines)} +${range(hunk.newStart, hunk.newLines)} @@\\n${hunk.lines.join(\"\\n\")}\\n`,\n  ).join(\"\")\n}\nconst spans = (hunks) => hunks.map((hunk) => [hunk.deletionStart, hunk.deletionCount, hunk.additionStart, hunk.additionCount])\nconst equal = (a, b) => JSON.stringify(a) === JSON.stringify(b)\nconst engine = createDiffEngine()\nconst results = []\nconst failures = []\nlet subsetCases = 0\ntry {\n  for (const { name, before, after } of fixtures) {\n    try {\n      const oldFile = { name: \"fixture.txt\", contents: before }\n      const newFile = { name: \"fixture.txt\", contents: after }\n      const pierre = parseDiffFromFile(oldFile, newFile, undefined, true)\n      const preview = await engine.diff(before, after)\n      assert.equal(await engine.applyHunks(before, preview.hunks), after, `${name}: full forward apply`)\n      const adapted = processFile(patchText(preview), { oldFile, newFile, throwOnError: true })\n      assert.ok(adapted, `${name}: public processFile must produce metadata`)\n      assert.equal(adapted.isPartial, false)\n      assert.equal(adapted.additionLines.join(\"\"), after)\n      assert.equal(adapted.deletionLines.join(\"\"), before)\n      const sameSpans = equal(spans(adapted.hunks), spans(pierre.hunks))\n      let sameReverts = sameSpans\n      for (let excluded = 0; excluded < preview.hunks.length; excluded++) {\n        // Forward complement onto the original snapshot; this is coordinate\n        // adaptation only. The canonical engine still validates and applies it.\n        let delta = 0\n        const subset = []\n        for (const [index, hunk] of preview.hunks.entries()) {\n          if (index === excluded) continue\n          subset.push({ ...hunk, newStart: hunk.oldStart + delta })\n          delta += hunk.newLines - hunk.oldLines\n        }\n        const reconstructed = await engine.applyHunks(before, subset)\n        const adapterRevert = diffAcceptRejectHunk(adapted, excluded, \"reject\").additionLines.join(\"\")\n        assert.equal(reconstructed, adapterRevert, `${name}: precomputed renderer/revert identity`)\n        if (sameSpans) {\n          const existingRevert = diffAcceptRejectHunk(pierre, excluded, \"reject\").additionLines.join(\"\")\n          sameReverts &&= reconstructed === existingRevert\n        }\n        subsetCases++\n      }\n      results.push({ name, hunks: preview.hunks.length, sameSpans, sameReverts, sameMetadata: isDeepStrictEqual(adapted, pierre),\n        ...(sameSpans ? {} : { canonical: spans(adapted.hunks), pierre: spans(pierre.hunks) }) })\n    } catch (error) {\n      failures.push({ name, error: String(error) })\n    }\n  }\n  const strict = await engine.diff(\"old\\n\", \"new\\n\")\n  await assert.rejects(engine.applyHunks(\"stale\\n\", strict.hunks), /mismatched/)\n  const controller = new AbortController()\n  controller.abort()\n  await assert.rejects(engine.diff(\"a\", \"b\", { signal: controller.signal }), { name: \"AbortError\" })\n  assert.equal((await engine.diff(\"a\\n\", \"b\\n\")).additions, 1)\n} finally {\n  await engine.close()\n}\nconst report = {\n  node: process.version,\n  engineSha256: createHash(\"sha256\").update(await readFile(enginePath)).digest(\"hex\"),\n  fixtures: fixtures.length,\n  successful: results.length,\n  fullForwardRoundTrips: results.length,\n  rendererSubsetRevertCases: subsetCases,\n  identicalSpans: results.filter((result) => result.sameSpans).length,\n  identicalFullMetadata: results.filter((result) => result.sameMetadata).length,\n  identicalRevertsWhenSpansMatch: results.filter((result) => result.sameReverts).length,\n  strictStaleContextRejected: true,\n  preAbortedRequestRejectedAndNextCallWorked: true,\n  failures,\n  results,\n}\nconsole.log(JSON.stringify(report, null, 2))\nprocess.exitCode = failures.length ? 1 : 0\n\nFILE benchmark.mjs\n// Node compute/transfer measurements, not packaged UI latency percentiles.\nimport assert from \"node:assert/strict\"\nimport { readFile } from \"node:fs/promises\"\nimport os from \"node:os\"\nimport { resolve } from \"node:path\"\nimport { pathToFileURL } from \"node:url\"\n\nif (!process.argv[2]) throw new Error(\"Usage: node benchmark.mjs <canonical-dist/node.js>\")\nconst pierrePackage = new URL(\"../../../desktop/packages/ui/node_modules/@pierre/diffs/package.json\", import.meta.url)\nconst manifest = JSON.parse(await readFile(pierrePackage, \"utf8\"))\nconst { parseDiffFromFile, processFile } = await import(new URL(manifest.exports[\".\"].import, pierrePackage).href)\nconst { createDiffEngine } = await import(pathToFileURL(resolve(process.argv[2])).href)\nconst engine = createDiffEngine()\nconst results = []\nconst median = (values) => [...values].sort((a, b) => a - b)[Math.floor(values.length / 2)]\nconst patchText = (preview) => \"--- fixture.txt\\n+++ fixture.txt\\n\" + preview.hunks.map((hunk) => {\n  const range = (start, count) => `${count === 0 ? start - 1 : start},${count}`\n  return `@@ -${range(hunk.oldStart, hunk.oldLines)} +${range(hunk.newStart, hunk.newLines)} @@\\n${hunk.lines.join(\"\\n\")}\\n`\n}).join(\"\")\ntry {\n  const coldStart = performance.now()\n  await engine.diff(\"before\\n\", \"after\\n\")\n  const firstCallMs = performance.now() - coldStart\n  for (const count of [1000, 10000, 50000]) {\n    for (const stride of [count - 5, 50]) {\n      const lines = Array.from({ length: count }, (_, index) => `line ${index}: repeated text 中文 😀\\r\\n`)\n      const changed = lines.map((line, index) => index % stride === 2 ? `changed ${index}\\r\\n` : line)\n      const oldFile = { name: \"fixture.txt\", contents: lines.join(\"\") }\n      const newFile = { name: \"fixture.txt\", contents: changed.join(\"\") }\n      const modes = {\n        pierre: () => parseDiffFromFile(oldFile, newFile, undefined, true),\n        wasmAndMetadata: async () => processFile(patchText(await engine.diff(oldFile.contents, newFile.contents)), {\n          oldFile, newFile, throwOnError: true,\n        }),\n      }\n      const expected = modes.pierre()\n      try {\n        assert.deepEqual(await modes.wasmAndMetadata(), expected)\n      } catch (error) {\n        if (!String(error).includes(\"Diff resource limit exceeded\")) throw error\n        assert.equal((await engine.diff(\"a\\n\", \"b\\n\")).additions, 1)\n        results.push({ lines: count, stride, beforeCharacters: oldFile.contents.length,\n          rejected: String(error), workerRecoveredAfterLimit: true })\n        continue\n      }\n      const samples = { pierre: [], wasmAndMetadata: [] }\n      for (let iteration = 0; iteration < 7; iteration++) {\n        const order = iteration % 2 ? [\"wasmAndMetadata\", \"pierre\"] : [\"pierre\", \"wasmAndMetadata\"]\n        for (const mode of order) {\n          const start = performance.now()\n          const result = await modes[mode]()\n          samples[mode].push(performance.now() - start)\n          assert.deepEqual(result, expected)\n        }\n      }\n      results.push({ lines: count, stride, beforeCharacters: oldFile.contents.length, hunks: expected.hunks.length,\n        samples, medianMs: Object.fromEntries(Object.entries(samples).map(([key, values]) => [key, median(values)])) })\n    }\n  }\n  console.log(JSON.stringify({ node: process.version, cpu: os.cpus()[0]?.model, load: os.loadavg(), firstCallMs,\n    notes: \"Seven alternating warm samples; canonical includes Worker transfer and synchronous Pierre metadata projection. Excludes UI rendering, scheduling, cache hits and browser startup. No p95 or app-wide speed claim.\", results }, null, 2))\n} finally {\n  await engine.close()\n}\n"}}
