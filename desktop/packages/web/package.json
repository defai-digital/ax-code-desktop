{
  "name": "ax-code-desktop",
  "version": "7.30.5",
  "description": "AX Code local web runtime.",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./server/index.js",
  "types": "./server/index.d.ts",
  "bin": {
    "ax-code-desktop": "./bin/cli.js",
    "openchamber": "./bin/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm run build:watch",
    "dev:vite": "node scripts/dev-vite.mjs",
    "dev:server": "node server/index.js --port ${AX_CODE_DESKTOP_PORT:-3001}",
    "dev:server:watch": "nodemon --watch server --ext js --exec \"node server/index.js --port ${AX_CODE_DESKTOP_PORT:-3001}\"",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" \"./server/**/*.js\" --config ../../eslint.config.js",
    "test": "vitest run",
    "start": "node bin/cli.js serve"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@defai-digital/ax-code-sdk": "2.6.53",
    "@octokit/rest": "^22.0.1",
    "@openchamber/ui": "workspace:*",
    "@simplewebauthn/server": "13.3.2",
    "adm-zip": "^0.6.1",
    "compression": "^1.8.2",
    "cron-parser": "^4.9.0",
    "express": "^5.3.0",
    "express-rate-limit": "8.3.2",
    "http-proxy-middleware": "^3.0.7",
    "jose": "^6.2.12",
    "jsonc-parser": "^3.3.1",
    "luxon": "^3.7.2",
    "node-pty": "1.1.0",
    "simple-git": "^4.0.2",
    "ws": "8.21.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@eslint/js": "^9.39.5",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@simplewebauthn/browser": "13.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.2.5",
    "cors": "^2.8.6",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "nodemon": "^3.1.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.6",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "strip-json-comments": "^5.0.3",
    "supertest": "^7.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.15"
  },
  "files": [
    "dist",
    "server",
    "bin",
    "public",
    "package.json",
    "README.md"
  ]
}
