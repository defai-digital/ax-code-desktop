*.db
auth.json

# Staged application and runtime resources are generated, never source-controlled.
resources/ax-code/
desktop/packages/electron/resources/ax-code/
desktop/packages/electron/resources/ax-computer/
desktop/packages/electron/resources/web-dist/
desktop/packages/electron/.dev-bin/

# Local research checkouts and generated test profiles remain on disk only.
.internal/reference/*/
.internal/reviews/**/runtime-*/
.internal/reviews/**/engines/
.internal/reviews/**/verified-runtime/
.internal/reviews/**/*.app/
.internal/reviews/**/profile-*/
.internal/reviews/**/profile/
.internal/reviews/**/runtime-probe-all-requests.json
.internal/reviews/**/runtime-probe-messages.json
.internal/reviews/**/runtime-probe-state.json

# Local AX Wiki output (generated by `ax-code wiki`; never committed)
.ax-wiki/

# Local AX Code session data (goal plans, agent memory, run state written by `ax-code run`;
# never committed). It is per-session runtime state, so the whole directory is ignored: project
# configuration lives in config/ and .internal/, not here.
.ax-code/

# Local agent guidance. Keep the working copy; do not publish it.
/AGENTS.md

# Internal product records stay on disk. Do not publish them.
# Release scripts and the extraction map stay tracked because CI reads them.
/WX15-HANDOFF.md
/.internal/README.md
/.internal/prd/
/.internal/adr/
/.internal/spec/
/.internal/plans/
/.internal/reviews/
/.internal/reference/
/.internal/reports/*
!/.internal/reports/extraction/
/.internal/reports/extraction/*
!/.internal/reports/extraction/commit-map.txt
